{
  "name": "@lynia/shared",
  "version": "0.0.0",
  "private": true,
  "type": "commonjs",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./fixtures": {
      "types": "./dist/fixtures.d.ts",
      "default": "./dist/fixtures.js"
    },
    "./tokens": {
      "types": "./dist/tokens-entry.d.ts",
      "default": "./dist/tokens-entry.js"
    },
    "./restaurants-order": {
      "types": "./dist/restaurants-order.d.ts",
      "default": "./dist/restaurants-order.js"
    }
  },
  "files": [
    "dist",
    "src",
    "tokens.js",
    "tokens.d.ts",
    "restaurants-order.js",
    "restaurants-order.d.ts"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "oxlint -c ../../.oxlintrc.json src",
    "test": "vitest run"
  },
  "dependencies": {
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "oxlint": "^1.79.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.11"
  }
}
