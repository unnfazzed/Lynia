{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "assets/**",
              "assets/brand/**",
              "components/core/**",
              "components/feedback/**",
              "components/forms/**",
              "components/journey/**",
              "components/typography/**",
              "ui_kits/mobile/**",
              "ui_kits/support/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:Inter|Fredoka))/i]",
        "message": "Font not provided by the design system. Available: Inter, Fredoka."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|children|onClick|variant|disabled|loading|block|style|key|ref|className|style|children)$/]",
        "message": "<Button> doesn't accept that prop. Declared props: label, children, onClick, variant, disabled, loading, block, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:primary|ghost)$/]",
        "message": "<Button> variant must be one of 'primary' | 'ghost'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Card'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|accent|style|key|ref|className|style|children)$/]",
        "message": "<Card> doesn't accept that prop. Declared props: children, accent, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='EmptyState'] > JSXAttribute > JSXIdentifier[name!=/^(?:icon|title|message|children|style|key|ref|className|style|children)$/]",
        "message": "<EmptyState> doesn't accept that prop. Declared props: icon, title, message, children, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Field'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|value|onChange|placeholder|type|inputMode|maxLength|fromMap|disabled|error|hint|multiline|rows|style|key|ref|className|style|children)$/]",
        "message": "<Field> doesn't accept that prop. Declared props: label, value, onChange, placeholder, type, inputMode, maxLength, fromMap, disabled, error, hint, multiline, rows, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Field'] > JSXAttribute[name.name='inputMode'] > Literal[value!=/^(?:text|numeric|decimal|tel)$/]",
        "message": "<Field> inputMode must be one of 'text' | 'numeric' | 'decimal' | 'tel'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Heading'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|style|key|ref|className|style|children)$/]",
        "message": "<Heading> doesn't accept that prop. Declared props: children, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Icon'] > JSXAttribute > JSXIdentifier[name!=/^(?:name|size|color|strokeWidth|fill|style|key|ref|className|style|children)$/]",
        "message": "<Icon> doesn't accept that prop. Declared props: name, size, color, strokeWidth, fill, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Label'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|style|key|ref|className|style|children)$/]",
        "message": "<Label> doesn't accept that prop. Declared props: children, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='OfflineBanner'] > JSXAttribute > JSXIdentifier[name!=/^(?:state|style|key|ref|className|style|children)$/]",
        "message": "<OfflineBanner> doesn't accept that prop. Declared props: state, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='OfflineBanner'] > JSXAttribute[name.name='state'] > Literal[value!=/^(?:online|offline|reconnecting)$/]",
        "message": "<OfflineBanner> state must be one of 'online' | 'offline' | 'reconnecting'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Skeleton'] > JSXAttribute > JSXIdentifier[name!=/^(?:width|height|radius|style|key|ref|className|style|children)$/]",
        "message": "<Skeleton> doesn't accept that prop. Declared props: width, height, radius, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='SkeletonList'] > JSXAttribute > JSXIdentifier[name!=/^(?:count|variant|key|ref|className|style|children)$/]",
        "message": "<SkeletonList> doesn't accept that prop. Declared props: count, variant."
      },
      {
        "selector": "JSXOpeningElement[name.name='SkeletonList'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:card|row|stepper|summary)$/]",
        "message": "<SkeletonList> variant must be one of 'card' | 'row' | 'stepper' | 'summary'."
      },
      {
        "selector": "JSXOpeningElement[name.name='StatusPill'] > JSXAttribute > JSXIdentifier[name!=/^(?:status|tone|dot|style|key|ref|className|style|children)$/]",
        "message": "<StatusPill> doesn't accept that prop. Declared props: status, tone, dot, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='StatusPill'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:neutral|online|offline|reconnecting)$/]",
        "message": "<StatusPill> tone must be one of 'neutral' | 'online' | 'offline' | 'reconnecting'."
      },
      {
        "selector": "JSXOpeningElement[name.name='StepperEvent'] > JSXAttribute > JSXIdentifier[name!=/^(?:status|createdAt|key|ref|className|style|children)$/]",
        "message": "<StepperEvent> doesn't accept that prop. Declared props: status, createdAt."
      },
      {
        "selector": "JSXOpeningElement[name.name='Sub'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|style|key|ref|className|style|children)$/]",
        "message": "<Sub> doesn't accept that prop. Declared props: children, style."
      }
    ]
  },
  "overrides": [
    {
      "files": [
        "**/index.js"
      ],
      "rules": {
        "no-restricted-imports": "off"
      }
    }
  ],
  "x-omelette": {
    "components": {
      "Button": {
        "replaces": []
