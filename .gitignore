# gstack is installed per-developer, not vendored into the repo.
.claude/skills/gstack/

# Dependencies
node_modules/
.pnpm-store/

# Build output
dist/
build/
.next/
.turbo/
*.tsbuildinfo

# Expo / React Native
.expo/
.expo-shared/
apps/mobile/.expo/

# Firebase mobile credentials (founder-supplied per build — EAS file secret or a local drop;
# holds project identifiers, so keep it out of the repo)
google-services.json
GoogleService-Info.plist

# Google Play service-account key (lives in EAS credentials only — never in the repo or CI)
play-service-account.json

# Env / secrets
.env
.env.*
!.env.example

# Prisma
apps/api/prisma/*.db

# Logs / OS
*.log
.DS_Store

# Local Prisma engine binaries (fetched manually when the proxy blocks the download)
.prisma-engines/
.claude/worktrees/

# Next 16 auto-generates these on `next dev` (agentRules) — build noise, not source
apps/*/AGENTS.md
apps/*/CLAUDE.md

# turbo >= 2.11 writes a root AGENTS.md when it detects an AI agent; turbo.json opts out
# ("agentGuidance": false), and this catches any copy written before that took effect.
/AGENTS.md

# Cloudflare wrangler local state (apps/website)
.wrangler/
