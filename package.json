{
  "name": "lynia",
  "private": true,
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "lint": "turbo run lint",
    "depcruise": "depcruise --config .dependency-cruiser.cjs --ignore-known .dependency-cruiser-known-violations.json apps/api/src apps/mobile/src apps/admin/app apps/merchant/app packages/shared/src",
    "depcruise:baseline": "depcruise --config .dependency-cruiser.cjs --output-type baseline apps/api/src apps/mobile/src apps/admin/app apps/merchant/app packages/shared/src > .dependency-cruiser-known-violations.json",
    "contract:check": "node scripts/contract-snapshot.mjs --check",
    "contract:snapshot": "node scripts/contract-snapshot.mjs --write",
    "test": "turbo run test",
    "dev": "turbo run dev",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "db:migrate": "pnpm --filter @lynia/api migrate:deploy",
    "db:seed": "pnpm --filter @lynia/api seed"
  },
  "devDependencies": {
    "@types/node": "^26.4.0",
    "dependency-cruiser": "^18.2.0",
    "turbo": "^2.10.12",
    "typescript": "^6.0.3"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@prisma/client",
      "@prisma/engines",
      "prisma",
      "esbuild"
    ],
    "overrides": {
      "uuid@<11.1.1": "^11.1.1",
      "multer@<2.3.0": ">=2.3.0",
      "@xmldom/xmldom@<0.8.13": "^0.8.13",
      "tar@<7.5.21": ">=7.5.21",
      "vite@<6.4.3": "^6.4.3",
      "file-type@>=13.0.0 <21.3.2": ">=21.3.2",
      "qs@>=6.11.1 <6.16.0": ">=6.16.0",
      "js-yaml@<3.15.2": ">=3.15.2 <4.0.0",
      "js-yaml@>=4.0.0 <4.3.2": ">=4.3.2 <5.0.0",
      "postcss@<8.5.18": ">=8.5.18",
      "@hono/node-server@<2.0.10": ">=2.0.10",
      "fast-uri@>=3.0.0 <3.1.6": ">=3.1.6 <4.0.0",
      "fast-xml-parser@<5.10.1": ">=5.10.1",
      "sharp@<0.35.0": ">=0.35.0",
      "valibot@<1.4.2": ">=1.4.2",
      "brace-expansion@<1.1.21": "1.1.21",
      "brace-expansion@>=2.0.0 <2.1.7": "2.1.7",
      "brace-expansion@>=5.0.0 <5.0.12": ">=5.0.12 <6.0.0",
      "find-my-way@<9.7.0": ">=9.7.0",
      "nanoid@<3.3.18": ">=3.3.18 <4.0.0",
      "socket.io-parser@<4.2.7": ">=4.2.7",
      "engine.io@<6.6.10": ">=6.6.10 <7.0.0",
      "undici@>=6.0.0 <6.28.1": ">=6.28.1 <7.0.0",
      "undici@>=8.0.0 <8.10.2": ">=8.10.2 <9.0.0",
      "deepmerge-ts@<8.0.0": ">=8.0.0",
      "mysql2@<3.23.1": ">=3.23.1",
      "@grpc/grpc-js@<1.14.5": ">=1.14.5 <2.0.0",
      "proxy-addr@<2.0.8": ">=2.0.8 <3.0.0",
      "source-map-js@<1.2.2": ">=1.2.2 <2.0.0",
      "@prisma/studio-core>react": "18.3.1",
      "@prisma/studio-core>react-dom": "18.3.1"
    },
    "packageExtensions": {
      "posthog-react-native": {
        "peerDependencies": {
          "@types/react": "*",
          "react": "*",
          "react-native": "*"
        },
        "peerDependenciesMeta": {
          "@types/react": {
            "optional": true
          }
        }
      },
      "react-native-safe-area-context": {
        "peerDependencies": {
          "@types/react": "*"
        },
        "peerDependenciesMeta": {
          "@types/react": {
            "optional": true
          }
        }
      },
      "react-native-svg": {
        "peerDependencies": {
          "@types/react": "*"
        },
        "peerDependenciesMeta": {
          "@types/react": {
            "optional": true
          }
        }
      }
    }
  }
}
