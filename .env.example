# Lynia API environment (copy to apps/api/.env for local dev)

# --- Core ---
NODE_ENV=development
PORT=3000
# Express `trust proxy` — reverse-proxy hops in front of the API so req.ip is the real client (per-IP
# rate limits key off it), not the load balancer. "1" is verified for the deployed topology (external
# HTTPS ALB → Cloud Run ⇒ XFF is `client, lb`, one hop; see infra/terraform/lb.tf and config/env.ts).
# "false" for a direct/dev deploy; a subnet list ("loopback, 10.0.0.0/8") is also accepted.
TRUST_PROXY=1

# --- Database (PostgreSQL + PostGIS) ---
DATABASE_URL=postgresql://lynia:lynia@localhost:5432/lynia?schema=public
# Explicit connection-pool tuning (applied to the datasource URL by PrismaService). Optional:
# DATABASE_CONNECTION_LIMIT defaults to a deterministic 10; DATABASE_POOL_TIMEOUT to Prisma's default.
# DATABASE_CONNECTION_LIMIT=10
# DATABASE_POOL_TIMEOUT=10

# --- Redis (BullMQ jobs + Socket.IO pub/sub + OTP counters) ---
REDIS_URL=redis://localhost:6379

# --- Cloud provider (gcp — the only implemented target; the D7 adapter seam is the extension point) ---
CLOUD_PROVIDER=gcp

# Storage (object) — bucket/container name; credentials via the platform's env
STORAGE_BUCKET=lynia-media
GCP_STORAGE_PROJECT_ID=

# Push (FCM-direct, portable across clouds)
# fcm = send via firebase-admin; noop (default) = log only (dev/test, and prod until FCM is provisioned).
PUSH_PROVIDER=noop
# Optional project override; on Cloud Run ADC supplies it. For local "fcm" testing, set
# GOOGLE_APPLICATION_CREDENTIALS to a service-account key path (ADC) instead of embedding a key here.
FCM_PROJECT_ID=

# Secrets are injected as env at deploy time (D7: avoid managed-identity lock-in)

# --- Observability (OpenTelemetry, swappable exporter) ---
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SERVICE_NAME=lynia-api

# --- OTP: WhatsApp Cloud API (Meta) — only needed when OTP_CHANNEL=whatsapp ---
WHATSAPP_PHONE_NUMBER_ID=        # the sender phone-number ID from the Meta app
WHATSAPP_ACCESS_TOKEN=           # secret — system-user / permanent token (Bearer)
WHATSAPP_TEMPLATE_NAME=          # the approved authentication-category OTP template name
# WHATSAPP_TEMPLATE_LANG defaults to en; WHATSAPP_GRAPH_VERSION to v21.0; base URL to graph.facebook.com.
# WHATSAPP_OTP_COPY_CODE_BUTTON defaults to "true" (Meta auth templates have a copy-code button);
# set "false" if your approved template is body-only.
WHATSAPP_APP_SECRET=             # secret — Meta App Secret, signs the delivery-status webhook (distinct from ACCESS_TOKEN)
WHATSAPP_WEBHOOK_VERIFY_TOKEN=   # secret — answers Meta's one-time GET subscription handshake for POST /webhooks/whatsapp

# --- Other vendors (wired in later lanes) ---
SMS_GATEWAY_API_KEY=             # (not implemented — no SMS gateway consumer wired yet)
# Mobile build vars (EAS secrets / apps/mobile/.env — consumed by app.config.ts, NOT the API):
GOOGLE_MAPS_API_KEY=             # Android Maps key (react-native-maps); iOS uses Apple Maps
# Path to the founder-supplied Firebase google-services.json (Android FCM). Provide it as an EAS
# **file** secret named GOOGLE_SERVICES_JSON, or drop the file at apps/mobile/google-services.json
# (gitignored). Required for the dev/standalone build to mint a native FCM token → live push.
GOOGLE_SERVICES_JSON=

# --- KYC: Didit (verifies Zimbabwean national IDs) ---
# auto (default) = submit to the vendor | manual = leave pending for admin review (T7 backstop)
KYC_MODE=auto
# stub (default, no external calls) | didit
KYC_PROVIDER=stub
DIDIT_API_KEY=                  # secret — x-api-key for every verification.didit.me/v3/* call
# Per-session config (NOT a secret): the workflow run on each session. e.g. the "Free KYC" workflow
# is ef08effc-4f57-4c16-b06f-e41c04445eec — get yours from the console (Workflows) or GET /v3/workflows/.
DIDIT_WORKFLOW_ID=
DIDIT_WEBHOOK_SECRET=           # secret — register a v3 webhook destination; this is its secret_shared_key
DIDIT_CALLBACK_URL=             # post-verification browser redirect (success page / app deep link) — NOT the webhook
# DIDIT_BASE_URL defaults to https://verification.didit.me
# Webhook: register a webhook_version=v3 destination at URL <api>/kyc/callback; we verify the
# X-Signature-V2 HMAC (canonical body) + a 300s X-Timestamp freshness window.

# --- Local dev quickstart (no cloud) ---
# Copy to apps/api/.env, then: pnpm db:up && pnpm db:migrate && pnpm db:seed && pnpm dev
#   DATABASE_URL=postgresql://lynia:lynia@localhost:5432/lynia?schema=public
#   REDIS_URL=redis://localhost:6379
#   OTP_CHANNEL=console
# For the admin dashboard to show live data, set in apps/admin: API_BASE_URL=http://localhost:3000

# --- Auth (lane B) ---
# This dev default is REJECTED at boot when NODE_ENV=production: the production boot-guard requires a
# unique secret of >= 32 chars (config/env.ts). Inject the real value from Secret Manager in prod.
JWT_SIGNING_SECRET=dev-insecure-secret-change-me-please
# Zero-downtime rotation of the signing secret (docs/SECRET-ROTATION.md): set this to the OLD secret
# while JWT_SIGNING_SECRET holds the new one, so in-flight access tokens keep verifying. Remove it
# after ACCESS_TTL_SECONDS has elapsed. Accepted on verify only; new tokens use JWT_SIGNING_SECRET.
JWT_SIGNING_SECRET_PREVIOUS=
# Dedicated HMAC key for hashing OTP codes + refresh tokens. Set it (independent of JWT_SIGNING_SECRET)
# so the signing secret can rotate WITHOUT invalidating stored refresh-token hashes. Defaults to
# JWT_SIGNING_SECRET when unset. One-time migration: set it to the CURRENT JWT_SIGNING_SECRET value.
TOKEN_HASH_SECRET=
# At-rest encryption key for national IDs (LR8): HKDF-derived into an AES-256-GCM key (encrypt the ID)
# + an HMAC key (dedup hash). REQUIRED in production (the boot-guard rejects the dev default / any
# <32-char value) — provisioned by Terraform (infra/terraform/secrets.tf) into Secret Manager. After
# first deploy, run the one-time backfill: `pnpm --filter @lynia/api encrypt-ids -- --apply`.
PII_ENCRYPTION_KEY=dev-insecure-pii-key-change-me-please
# Data retention (LR8, docs/DATA-RETENTION.md). GPS coords on order_events are scrubbed this many days
# after the event; expired sessions are deleted this many days after they lapse. Driven by the daily
# POST /admin/retention/purge sweep (Cloud Scheduler).
GPS_RETENTION_DAYS=90
SESSION_RETENTION_DAYS=30
ACCESS_TTL_SECONDS=900
REFRESH_TTL_SECONDS=2592000
OTP_TTL_SECONDS=300
# E4: whatsapp (default) | sms | console (logs the code — local dev, no provider).
# OTP_CHANNEL=console is REJECTED in production (it logs codes / pairs with the devCode escape hatch).
OTP_CHANNEL=whatsapp
# QA/launch safety: comma-separated phone numbers for which requestOtp returns the code in its
# response (bypasses real OTP send). Only effective on OTP_CHANNEL=console and only for listed
# numbers. Empty = off (default). REJECTED (non-empty) in production by the boot-guard.
OTP_TEST_PHONES=

# --- CORS ---
# Explicit browser-origin allow-list for HTTP + WebSocket (comma-separated), e.g.
# https://admin.lynia.example,https://console.lynia.example . Native mobile clients send no Origin and
# are always allowed; an empty list denies all *cross-origin browser* requests (default-deny). This
# replaces the previous wildcard Socket.IO CORS. Set to the admin console origin(s) in prod.
CORS_ALLOWED_ORIGINS=
