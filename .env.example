# Lynia API environment (copy to apps/api/.env for local dev)

# --- Core ---
NODE_ENV=development
PORT=3000
# Express `trust proxy` — reverse-proxy hops in front of the API so req.ip is the real client (per-IP
# rate limits key off it), not the load balancer. "1" is verified for the deployed topology (external
# HTTPS ALB → Cloud Run ⇒ XFF is `client, lb`, one hop; see infra/terraform/lb.tf and config/env.ts).
# "false" for a direct/dev deploy; a subnet list ("loopback, 10.0.0.0/8") is also accepted.
TRUST_PROXY=1

# --- Database (PostgreSQL + PostGIS) ---
DATABASE_URL=postgresql://lynia:lynia@localhost:5432/lynia?schema=public
# Explicit connection-pool tuning (applied to the datasource URL by PrismaService). Optional:
# DATABASE_CONNECTION_LIMIT defaults to a deterministic 10; DATABASE_POOL_TIMEOUT to Prisma's default.
# DATABASE_CONNECTION_LIMIT=10
# DATABASE_POOL_TIMEOUT=10

# --- Redis (BullMQ jobs + Socket.IO pub/sub + OTP counters) ---
REDIS_URL=redis://localhost:6379

# --- Cloud provider (gcp — the only implemented target; the D7 adapter seam is the extension point) ---
CLOUD_PROVIDER=gcp

# Storage (object) — bucket/container name; credentials via the platform's env
STORAGE_BUCKET=lynia-media
GCP_STORAGE_PROJECT_ID=

# Push (FCM-direct, portable across clouds)
# fcm = send via firebase-admin; noop (default) = log only (dev/test, and prod until FCM is provisioned).
PUSH_PROVIDER=noop
# Optional project override; on Cloud Run ADC supplies it. For local "fcm" testing, set
# GOOGLE_APPLICATION_CREDENTIALS to a service-account key path (ADC) instead of embedding a key here.
FCM_PROJECT_ID=

# Secrets are injected as env at deploy time (D7: avoid managed-identity lock-in)

# --- Observability (OpenTelemetry, swappable exporter) ---
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SERVICE_NAME=lynia-api

# --- OTP: WhatsApp Cloud API (Meta) — only needed when OTP_CHANNEL=whatsapp ---
WHATSAPP_PHONE_NUMBER_ID=        # the sender phone-number ID from the Meta app
WHATSAPP_ACCESS_TOKEN=           # secret — system-user / permanent token (Bearer)
WHATSAPP_TEMPLATE_NAME=          # the approved authentication-category OTP template name
# WHATSAPP_TEMPLATE_LANG defaults to en; WHATSAPP_GRAPH_VERSION to v21.0; base URL to graph.facebook.com.
# WHATSAPP_OTP_COPY_CODE_BUTTON defaults to "true" (Meta auth templates have a copy-code button);
# set "false" if your approved template is body-only.
WHATSAPP_APP_SECRET=             # secret — Meta App Secret, signs the delivery-status webhook (distinct from ACCESS_TOKEN)
WHATSAPP_WEBHOOK_VERIFY_TOKEN=   # secret — answers Meta's one-time GET subscription handshake for POST /webhooks/whatsapp

# --- OTP: Bird (bird.com) SMS channel — only needed when OTP_CHANNEL=bird ---
# Bird is a plain-SMS delivery pipe (fast path while WhatsApp Business verification is pending). We still
# generate/hash/verify the code ourselves — Bird only sends the SMS. Reverting to WhatsApp is a one-line
# OTP_CHANNEL flip. Sends go to POST /v1/sms/messages — there is no channel id; the key is workspace-scoped.
BIRD_ACCESS_KEY=                 # secret — a workspace API key (bk_<region>_…), sent as `Authorization: Bearer <key>`
BIRD_SMS_FROM=                   # sender ID shown on the SMS, e.g. LyniaGo (NOT a secret). Required for +263:
                                 # without it Bird has no eligible shared-pool sender and rejects with E12003.
BIRD_WEBHOOK_SECRET=             # secret — signing key (whsec_…) for the delivery-status webhook at
                                 # POST /webhooks/bird. Bird returns it ONCE when the endpoint is created and
                                 # never again. Without it that receiver fails closed in prod / on OTP_CHANNEL=bird.
# BIRD_BASE_URL defaults to https://eu1.platform.bird.com — Bird's API is REGION-scoped, so this must match
# the workspace's region (`bird auth status` reports it; the key prefix encodes it). BIRD_BRAND_NAME defaults
# to "LyniaGo" (shown in the SMS: "<code> is your LyniaGo verification code.").
# BIRD_ANDROID_SMS_HASH: optional 11-char SMS Retriever app hash. Set it to append the hash to the SMS
# so Android reads the code with ZERO taps. Leave empty for a clean SMS — iOS autofill and Android's
# sms-otp autofill hint still work without it. Derive the hash from your release signing cert.
BIRD_ANDROID_SMS_HASH=

# --- OTP: local A2P SMS gateway — only needed when OTP_CHANNEL=local-sms ---
# Zimbabwe fallback for when Bird's international route is throttled on Econet's grey-route filtering.
# Point it at Econet A2P (direct) or a local bulk-SMS aggregator. Delivery pipe only (we still
# generate/hash/verify the code). Confirm the request shape (otp-sender.ts buildLocalSmsRequest) and the
# auth header against your provider's API doc before going live.
LOCAL_SMS_API_URL=               # the gateway's send endpoint (POST JSON)
LOCAL_SMS_API_KEY=               # secret — sent as `Authorization: Bearer <key>`
# LOCAL_SMS_SENDER_ID defaults to "LyniaGo" (alphanumeric, 11-char max — register it with the operators/
# POTRAZ; you can send on a default route while the branded ID is pending). It doubles as the brand in
# the SMS body. LOCAL_SMS_ANDROID_HASH: optional SMS Retriever hash (same as BIRD_ANDROID_SMS_HASH).
LOCAL_SMS_SENDER_ID=
LOCAL_SMS_ANDROID_HASH=

# --- OTP: Bird Verify API (bird.com) — only needed when OTP_CHANNEL=bird-verify ---
# A DIFFERENT Bird product from the plain-SMS BIRD_ACCESS_KEY above: Verify owns code generation,
# delivery (WhatsApp first, SMS fallback), expiry and attempt-limiting entirely — this app only calls
# its create/check endpoints, with nothing of its own to store. Needs its OWN workspace API key scoped
# to Verify (BIRD_ACCESS_KEY's SMS-only scope does not cover it). See docs/BIRD-SETUP.md "Bird Verify".
BIRD_VERIFY_API_KEY=              # secret — a workspace API key (bk_<region>_…). The region is read
                                  # from the key's own prefix, so there is no separate base-url var.

# --- Other vendors (wired in later lanes) ---
SMS_GATEWAY_API_KEY=             # (not implemented — no SMS gateway consumer wired yet)
# Mobile build vars (EAS secrets / apps/mobile/.env — consumed by app.config.ts, NOT the API):
GOOGLE_MAPS_API_KEY=             # Android Maps key (react-native-maps); iOS uses Apple Maps
# Google Places key for search-first addressing. SEPARATE from GOOGLE_MAPS_API_KEY above: a build with
# only the Maps key renders the map fine and ships NO address search at all (src/config.ts placesEnabled).
# Must be set in the EAS `production` + `preview` environments, not just here — eas.json declares
# `environment:` and pulls the value server-side. See docs/SECURITY-OPS.md §B for the restrictions this
# key needs (it calls the Places WEB SERVICE, so Android app restrictions do NOT work on it).
EXPO_PUBLIC_GOOGLE_PLACES_KEY=   # Places Autocomplete + Details; unset ⇒ address search hidden app-wide
# Path to the founder-supplied Firebase google-services.json (Android FCM). Provide it as an EAS
# **file** secret named GOOGLE_SERVICES_JSON, or drop the file at apps/mobile/google-services.json
# (gitignored). Required for the dev/standalone build to mint a native FCM token → live push.
GOOGLE_SERVICES_JSON=

# --- KYC: Didit (verifies Zimbabwean national IDs) ---
# auto (default) = submit to the vendor | manual = leave pending for admin review (T7 backstop)
KYC_MODE=auto
# stub (default, no external calls) | didit
KYC_PROVIDER=stub
DIDIT_API_KEY=                  # secret — x-api-key for every verification.didit.me/v3/* call
# Per-session config (NOT a secret): the workflow run on each session. e.g. the "Free KYC" workflow
# is ef08effc-4f57-4c16-b06f-e41c04445eec — get yours from the console (Workflows) or GET /v3/workflows/.
DIDIT_WORKFLOW_ID=
DIDIT_WEBHOOK_SECRET=           # secret — register a v3 webhook destination; this is its secret_shared_key
DIDIT_CALLBACK_URL=             # post-verification browser redirect — NOT the webhook. Set it to <api>/kyc/return:
                                # the in-app ID-check sheet treats leaving the vendor's host as its completion
                                # signal, and older builds' in-app browser tab lands on the branded page, whose
                                # lynia:// redirect bounces them back into the app.
# DIDIT_BASE_URL defaults to https://verification.didit.me
# Webhook: register a webhook_version=v3 destination at URL <api>/kyc/callback; we verify the
# X-Signature-V2 HMAC (canonical body) + a 300s X-Timestamp freshness window.

# --- Local dev quickstart (no cloud) ---
# Copy to apps/api/.env, then: pnpm db:up && pnpm db:migrate && pnpm db:seed && pnpm dev
#   DATABASE_URL=postgresql://lynia:lynia@localhost:5432/lynia?schema=public
#   REDIS_URL=redis://localhost:6379
#   OTP_CHANNEL=console
# For the admin dashboard to show live data, set in apps/admin: API_BASE_URL=http://localhost:3000

# --- Auth (lane B) ---
# This dev default is REJECTED at boot when NODE_ENV=production: the production boot-guard requires a
# unique secret of >= 32 chars (config/env.ts). Inject the real value from Secret Manager in prod.
JWT_SIGNING_SECRET=dev-insecure-secret-change-me-please
# Zero-downtime rotation of the signing secret (docs/SECRET-ROTATION.md): set this to the OLD secret
# while JWT_SIGNING_SECRET holds the new one, so in-flight access tokens keep verifying. Remove it
# after ACCESS_TTL_SECONDS has elapsed. Accepted on verify only; new tokens use JWT_SIGNING_SECRET.
JWT_SIGNING_SECRET_PREVIOUS=
# Dedicated HMAC key for hashing OTP codes + refresh tokens. Set it (independent of JWT_SIGNING_SECRET)
# so the signing secret can rotate WITHOUT invalidating stored refresh-token hashes. Defaults to
# JWT_SIGNING_SECRET when unset. One-time migration: set it to the CURRENT JWT_SIGNING_SECRET value.
TOKEN_HASH_SECRET=
# At-rest encryption key for national IDs (LR8): HKDF-derived into an AES-256-GCM key (encrypt the ID)
# + an HMAC key (dedup hash). REQUIRED in production (the boot-guard rejects the dev default / any
# <32-char value) — provisioned by Terraform (infra/terraform/secrets.tf) into Secret Manager. After
# first deploy, run the one-time backfill: `pnpm --filter @lynia/api encrypt-ids -- --apply`.
PII_ENCRYPTION_KEY=dev-insecure-pii-key-change-me-please
# Data retention (LR8, docs/DATA-RETENTION.md). GPS coords on order_events are scrubbed this many days
# after the event; expired sessions are deleted this many days after they lapse. Driven by the daily
# POST /admin/retention/purge sweep (Cloud Scheduler).
GPS_RETENTION_DAYS=90
SESSION_RETENTION_DAYS=30
ACCESS_TTL_SECONDS=900
# How long a signed-in user stays signed in. Rolling: each refresh rotates the session and re-stamps the
# window, so opening the app once a year means never re-entering an OTP. Defaults to 1 year (31536000).
REFRESH_TTL_SECONDS=31536000
OTP_TTL_SECONDS=300
# OTP send caps. Overridable so the ceiling can be TIGHTENED during an incident (or widened for a
# launch push) without shipping code. Leave unset to take the defaults shown.
#   OTP_RL_PHONE_MAX=5           # sends per phone, per hour
#   OTP_RL_IP_MAX=20             # sends per IP, per hour
#   OTP_RL_DEVICE_SIGNUP_MAX=3   # NEW accounts per device (x-device-id), per day
# The global daily cap is a SPEND ceiling as much as an abuse one: POST /auth/otp/request is
# unauthenticated because it IS the signup entry point, and each Bird SMS costs ~EUR 0.195 — so
# worst-case daily spend is roughly this number x that price. 500/day (~EUR 98/day) is sized for a
# PILOT, not for launch volume. Raise it before opening signups or real users will hit the ceiling.
#   OTP_RL_GLOBAL_MAX=500        # all senders, per day
# E4: whatsapp (default) | bird (SMS via bird.com) | local-sms (SMS via a local A2P gateway) | sms
# (unimplemented stub) | bird-verify (Bird's Verify API owns the whole generate/send/verify cycle,
# WhatsApp-first with an SMS fallback) | console (logs the code — local dev, no provider).
# OTP_CHANNEL=console is REJECTED in production. For bird, set BIRD_ACCESS_KEY / BIRD_SMS_FROM; for
# local-sms, set LOCAL_SMS_API_URL / LOCAL_SMS_API_KEY; for bird-verify, set BIRD_VERIFY_API_KEY.
OTP_CHANNEL=whatsapp
# QA/launch safety: comma-separated phone numbers for which requestOtp returns the code in its
# response (bypasses real OTP send). Only effective on OTP_CHANNEL=console and only for listed
# numbers. Empty = off (default). REJECTED (non-empty) in production by the boot-guard.
OTP_TEST_PHONES=

# --- CORS ---
# Explicit browser-origin allow-list for HTTP + WebSocket (comma-separated), e.g.
# https://kitchen.lynia.example,https://console.lynia.example . Native mobile clients send no Origin
# and are always allowed; an empty list denies all *cross-origin browser* requests (default-deny).
# This replaces the previous wildcard Socket.IO CORS.
#
# In prod this MUST contain the merchant dashboard's origin (apps/merchant —
# https://lyniagomerchant.lyniafinance.com), which is a real browser client: it signs in, mutates the
# queue and opens the Socket.IO queue socket straight from the tab. Leave it out and every one of
# those calls dies at preflight, which the dashboard shows as "Couldn't reach the server" while the
# API is perfectly healthy and logs nothing (docs/KNOWN_BUGS.md OPS-CORS-01). release.yml now always
# includes that origin, so this is only set by hand for a local/other browser client.
#
# The ADMIN console needs no entry: it calls the API server-side (apps/admin/app/lib/api.ts) and its
# browser never talks to this service directly.
# Entries are bare origins — scheme://host[:port], no path, no trailing slash.
CORS_ALLOWED_ORIGINS=

# --- Merchant verticals (docs/plans/2026-07-26-merchant-verticals-plan.md §0b.3) ---
# Kill switches for the merchant vertical, fail-safe OFF. Served publicly to the app via
# GET /app/feature-flags (its "remote config"); flipping one = Cloud Run env update (~1 min).
# Cohort gating (which pilot merchants/devices) lives on domain rows, not here.
RESTAURANTS_ENABLED=false
MERCHANT_DISPATCH_AUTO_ENABLED=false
MERCHANT_WALLET_ENABLED=false
