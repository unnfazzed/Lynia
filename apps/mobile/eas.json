{
  "cli": {
    "version": ">= 13.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "base": {
      "pnpm": "10.33.0",
      "autoIncrement": true
    },
    "preview": {
      "extends": "base",
      "channel": "preview",
      "environment": "preview",
      "android": {
        "buildType": "app-bundle"
      }
    },
    "production": {
      "extends": "base",
      "channel": "production",
      "environment": "production",
      "autoIncrement": true,
      "android": {
        "buildType": "app-bundle"
      }
    },
    "closed": {
      "extends": "base",
      "channel": "preview",
      "environment": "preview",
      "android": {
        "buildType": "app-bundle"
      }
    },
    "ios-simulator": {
      "extends": "base",
      "ios": {
        "simulator": true,
        "image": "macos-sequoia-15.6-xcode-26.2"
      },
      "env": {
        "SENTRY_DISABLE_AUTO_UPLOAD": "true"
      }
    }
  },
  "submit": {
    "preview": {
      "android": {
        "track": "internal"
      }
    },
    "production": {
      "android": {
        "track": "production",
        "releaseStatus": "inProgress",
        "rollout": 0.1
      }
    },
    "closed": {
      "android": {
        "track": "Closed testing"
      }
    }
  }
}
