// lyniago.com — the marketing site (docs/WEBSITE.md). A static-asset Worker: every request is a free,
// unmetered static-asset request served from Cloudflare's edge, except /download and /r/<code>, the paths
// that run worker.js (the smart download link: Play on Android, the web app on iPhone, the QR section on
// desktop; and a biker's referral link, D-112; `run_worker_first`). Even unknown paths never reach the
// script. `site/` is the approved design handoff (packages/design/handoff/lyniago-website/site) plus the
// launch edits that scripts/check-website.mjs allows; it is deployed as-is, there is no build step.
//
// Deployed by .github/workflows/deploy-website.yml. www.lyniago.com is a separate Worker
// (www-redirect/) because a static-asset Worker cannot redirect by hostname.
{
  "name": "lyniago-website",
  "main": "./worker.js",
  "compatibility_date": "2026-09-01",
  "assets": {
    "directory": "./site",
    "binding": "ASSETS",
    "run_worker_first": ["/download", "/download/", "/r/*"],
    // Unknown paths (including /about until its copy exists) get site/404.html with a real 404 status.
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash"
  },
  // Custom Domain: Cloudflare creates the DNS record and the edge certificate itself.
  "routes": [{ "pattern": "lyniago.com", "custom_domain": true }],
  // One public host only. The canonical tag says https://lyniago.com/, so no *.workers.dev copy.
  "workers_dev": false,
  "preview_urls": false
}
