// Lynia data model (refines CONCEPT §5; constraints from ENG-REVIEW ET6/ET7).
// Prisma owns the schema + typed client; the offer-loop hot path (guarded CAS) and the
// PostGIS geography column are driven by raw SQL — see prisma/migrations/0001_init/migration.sql.

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
  // node:*-slim is Debian bookworm (OpenSSL 3). Pin the engine so it's never the
  // 1.1.x default (which needs libssl.so.1.1, absent on bookworm → boot crash).
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

// The connection URL lives in prisma.config.ts (CLI/Migrate) and the pg driver adapter in
// PrismaService (runtime) — Prisma 7 removed `url` from schema datasource blocks.
datasource db {
  provider   = "postgresql"
  extensions = [postgis]
}

enum Role {
  customer
  rider
  merchant
  admin
}

enum OrderType {
  parcel
  merchant
}

enum OrderStatus {
  requested
  open_for_offers
  assigned
  confirmed
  en_route_pickup
  picked_up
  en_route_dropoff
  delivered
  completed
  cancelled
  expired
  // Terminal: rider could not complete the hand-off (INTERFACE-AUDIT C6 / F-02). Reason + attempt
  // count recorded on the order; shown verbatim to the customer.
  undelivered
}

enum OfferType {
  accept
  counter
}

// C2 (food order lifecycle): merchant orders travel the existing OrderStatus skeleton — `requested`
// (never written by the parcel path, see the transitions-table docstring) is the kitchen-side phase
// while `MerchantPhase` carries the sub-states OrderStatus has no room for. Once a food order is
// `ready_for_pickup` it is handed to C3's dispatch, which moves it into open_for_offers/assigned/...
// exactly like a parcel (the plan §0b.1 locked decision).
enum MerchantPhase {
  awaiting_accept
  awaiting_item_approval
  awaiting_payment
  preparing
  ready_for_pickup
}

/** The customer's chosen settlement rail for a food order (R-01/R-11) — orthogonal to the merchant's
 *  own `cashRule` (how a CASH order is fronted), which stays a C3/C4 concern. */
enum MerchantPaymentMethod {
  cash
  wallet
}

// C4 (food money evidence layer): the collect-and-return merchant-debt ledger's derived state per
// order. `open` from pickup (R-01) until one of the three settling entries lands — see
// MerchantDebtEntryType below and MERCHANT_DEBT_TRANSITIONS in order-lifecycle.transitions.ts. Null
// on every order the debt model doesn't apply to (parcels, WALLET food orders, pay_upfront kitchens
// — deliberately out of scope this PR, see the FoodDebtService docstring).
enum MerchantDebtStatus {
  open
  settled_cash
  settled_goods
  written_off
}

// Append-only audit trail for the debt ledger (mirrors CommissionLedger's shape: one immutable row
// per money-relevant event, never updated/deleted). `@@unique([orderId, type])` makes each write
// idempotent under a retry — at most one `opened` row and one settling row (whichever type) per
// order, ever.
enum MerchantDebtEntryType {
  opened
  settled_cash
  settled_goods
  written_off
}

enum OfferStatus {
  pending
  selected
  declined
  expired
}

enum KycStatus {
  pending
  verified
  failed
  // A previously-verified rider whose national ID later lapsed (rider-journey 1·b2). Must re-verify;
  // blocked from going online like the other non-verified states.
  expired
}

// Rider account standing (A-04) — distinct from KYC + the reliability on_hold flag.
enum RiderAccountStatus {
  active
  suspended
  banned
}

// Weekly cash settlement status (A-06).
enum SettlementStatus {
  pending
  paid
  overdue
}

// Prepaid commission wallet (docs/plans/2026-rider-wallet-design.md). Every balance change is one
// append-only CommissionLedger row; the CommissionAccount balance is a cached running total.
enum CommissionEntryType {
  // Per-ride commission debit written in the completion transaction (negative amount).
  ride_commission
  // Rider top-up credit (mobile-money rail or ops-recorded manual credit), positive.
  topup
  // Flip-day starting/grace credit, positive.
  grace
  // Fare-adjust delta or ops correction; sign varies. Fare-adjusts append a delta here at the ride's
  // original rate so the one-ride_commission-row-per-order invariant stays absolute (design 4A/OV-1A).
  adjustment
  // RESERVED — no writer in the wallet-core build (kept so the ledger type set is complete).
  reversal
}

// The rail a top-up came in on. Mobile-money rails push a USSD prompt; `manual` is an ops-recorded credit.
enum TopUpRail {
  ecocash
  innbucks
  omari
  manual
}

// A top-up intent's lifecycle. `pending` waits on the rail prompt (or ops); the rest are terminal.
// `expired` stays re-openable (a late rail confirmation still credits exactly once) — see wallet.service.
enum TopUpStatus {
  pending
  confirmed
  declined
  expired
}

// Disputes / order-level support (A-05). A customer, recipient or rider raises an Issue against an
// order; ops investigates and resolves it.
enum IssueType {
  not_delivered
  wrong_item
  damaged
  payment_dispute
  rider_conduct
  customer_conduct
  other
}

enum IssueStatus {
  open
  investigating
  resolved
}

enum IssueResolution {
  refund
  rider_strike
  close_no_action
}

// Report-a-user after a trip (both roles). Distinct from an order dispute — a conduct/safety report.
enum ReportReason {
  rude
  unsafe
  fraud
  no_show
  inappropriate
  other
}

model Profile {
  id              String    @id @default(uuid()) @db.Uuid
  role            Role      @default(customer)
  firstName       String    @map("first_name")
  lastName        String    @map("last_name")
  phone           String    @unique
  email           String?
  // National ID (LR8): `idNumber` now holds AES-GCM ciphertext (PiiCryptoService, `v1:` prefix);
  // `idNumberHash` is the deterministic HMAC used as the equality key for duplicate-ID detection, so
  // the raw number is never the lookup key. Legacy rows stay plaintext until the backfill runs.
  idNumber        String?   @map("id_number")
  idNumberHash    String?   @map("id_number_hash")
  photoUrl        String?   @map("photo_url")
  phoneVerifiedAt DateTime? @map("phone_verified_at")
  ordersCount     Int       @default(0) @map("orders_count")
  // Customer account standing (S·2). A boolean, not an enum: unlike a rider (active/suspended/banned),
  // a customer has exactly one moderated state — held or not. A held customer is blocked from
  // broadcasting a new order (OrdersService.create); `holdReason` backs the audit row + admin console.
  onHold          Boolean   @default(false) @map("on_hold")
  holdReason      String?   @map("hold_reason")
  // R-08 (C4): a customer who refuses/can't pay a collect-and-return CASH food order costs them
  // nothing in money — the merchant logs the loss and the goods return — but from then on they're
  // restricted to WALLET for food orders. Deliberately separate from `onHold` (which blocks placing
  // ANY order); this only narrows the payment method on future food orders.
  cashBanned      Boolean   @default(false) @map("cash_banned")
  cashBanReason   String?   @map("cash_ban_reason")
  cashBannedAt    DateTime? @map("cash_banned_at")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  rider           Rider?
  merchant        Merchant?
  customerOrders  Order[]       @relation("customerOrders")
  cancelledOrders Order[]       @relation("cancelledByOrders")
  sessions        Session[]
  addresses       Address[]
  ratingsGiven    Rating[]      @relation("ratingBy")
  deviceTokens    DeviceToken[]

  @@index([idNumberHash])
  @@map("profiles")
}

// FCM device push tokens. A profile can have many (multiple devices); a token is globally unique and
// re-registering reassigns it to the current owner. Cascade-deleted with the profile.
model DeviceToken {
  id        String   @id @default(uuid()) @db.Uuid
  profileId String   @map("profile_id") @db.Uuid
  profile   Profile  @relation(fields: [profileId], references: [id], onDelete: Cascade)
  token     String   @unique
  platform  String?
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([profileId])
  @@map("device_tokens")
}

model Rider {
  profileId       String    @id @map("profile_id") @db.Uuid
  profile         Profile   @relation(fields: [profileId], references: [id], onDelete: Cascade)
  vehicleInfo     String?   @map("vehicle_info")
  bikeReg         String    @map("bike_reg")
  photoUrl        String    @map("photo_url")
  idVerified      Boolean   @default(false) @map("id_verified")
  kycStatus       KycStatus @default(pending) @map("kyc_status")
  // Unique so a Didit Approved/Declined webhook (keyed by session_id == kycRef) resolves exactly one
  // rider. kycResolvedAt is the last applied webhook's event time — a monotonic guard so a replayed
  // or out-of-order delivery can't overwrite a newer decision (see RiderService.applyKycResult).
  kycRef          String?   @unique @map("kyc_ref")
  kycResolvedAt   DateTime? @map("kyc_resolved_at")
  // IR26-04 vendor-document dedupe: the HMAC hash (LR8 — never the raw number) of the document number
  // the KYC VENDOR actually verified, persisted from the Didit decision webhook on a `verified`
  // outcome. The dedupe axis the typed idNumberHash can't cover — a ban-evader can TYPE a different
  // number but must SHOW the same physical document. pii.hashId normalizes before hashing, so this is
  // directly comparable to Profile.idNumberHash. Retained on erasure like idNumberHash (DS15-02b).
  // Partial index managed via raw SQL (migration 0038).
  verifiedIdHash  String?   @map("verified_id_hash")
  isOnline        Boolean   @default(false) @map("is_online")
  lastHeartbeatAt DateTime? @map("last_heartbeat_at")
  currentLat      Float?    @map("current_lat")
  currentLng      Float?    @map("current_lng")
  // Dedicated timestamp of the last POSITION write (lat/lng/geog only), distinct from `updatedAt`
  // (@updatedAt bumps on ANY rider-row write). getSnapshot's no-Redis fallback uses this so a stale
  // position can't render as "live" off a timestamp freshened by an unrelated write. Managed via raw SQL.
  positionUpdatedAt DateTime? @map("position_updated_at")
  // Indexed source of truth for nearby-rider queries (ST_DWithin + GiST). Managed via raw SQL.
  geog            Unsupported("geography(Point, 4326)")?
  tripsCount      Int       @default(0) @map("trips_count")
  ratingAvg       Float     @default(0) @map("rating_avg")
  ratingCount     Int       @default(0) @map("rating_count")
  cancelStrikes   Int       @default(0) @map("cancel_strikes")
  // FRAUD P2-4: dispute-confirmed strikes (issues.resolve `rider_strike`), a SEPARATE axis from
  // cancelStrikes. Previously both shared cancel_strikes, so a rider's 3rd cancel (which resets that
  // counter to 0) wiped dispute strikes, and RIDER_STRIKE_LIMIT was never enforced on the dispute path.
  // Now its own counter with its own limit consequence (cooldown + offline). See issues.service.resolve.
  disputeStrikes  Int       @default(0) @map("dispute_strikes")
  cooldownUntil   DateTime? @map("cooldown_until")
  // KYC resubmission counter (admin A-02). Decline increments; attempt 2 locks → support. The admin
  // decision write-back sets kycStatus + this counter; the rider app reads it for the lock state.
  kycAttempts     Int       @default(0) @map("kyc_attempts")
  // The reason code from the most recent admin decline (admin A-02). Surfaced to the rider app so they
  // know what to fix on a resubmit, and recorded alongside the audit-log row. Cleared on approve.
  kycDeclineReason String?  @map("kyc_decline_reason")
  // Account standing (A-04) — only `active` may go online. suspended/banned are admin actions or a
  // settlement auto-pause (A-06). suspendReason carries the admin reason code / "settlement_overdue".
  accountStatus   RiderAccountStatus @default(active) @map("account_status")
  suspendReason   String?   @map("suspend_reason")
  // Duplicate-account guard (A-04; hardened 2026-07-26 to one-ID-one-account). A national ID on
  // another LIVE profile is now hard-REFUSED (409 id_in_use) at every ID-writing path
  // (completeProfile / auth.updateProfile, advisory-lock serialized) and at becomeRider — so this flag
  // no longer marks live collisions going forward. It persists for what remains: legacy pre-policy
  // rows, and collisions with ERASED tombstones (DS15-02b keeps their idNumberHash; a restricted
  // account can't self-erase, so a tombstone match is a legit returning user — allowed through, but
  // still reviewed: applyKycResult holds a flagged auto-verify, admin.getKycReview recomputes live).
  duplicateIdFlag Boolean   @default(false) @map("duplicate_id_flag")
  // Reliability (Q2). Starts at 100; cancels/no-shows/low-ratings decrement, clean deliveries recover.
  // onHold is the derived auto-gate (score < threshold) — a separate axis from accountStatus; a rider
  // can be active-but-on-hold. Both the online-gate reads. See packages/shared/src/policy.ts RELIABILITY.
  reliabilityScore Int      @default(100) @map("reliability_score")
  onHold          Boolean   @default(false) @map("on_hold")
  // RH-01 (DEEP-SWEEP-2026-07-13): WHY the rider is held, so applyReliabilityDelta's score hysteresis
  // can tell a self-clearing score hold ("reliability") apart from the FRAUD P0-3 velocity/fraud hold
  // ("velocity", #198) that must survive a score recovery and only be released by an admin clear-hold.
  // null = not held (or a legacy on_hold row from before this column → score-clearable, as before). See
  // packages/shared/src/policy.ts HeldReason. Kept in lockstep with that shared union.
  heldReason      String?   @map("held_reason")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  orders      Order[]      @relation("riderOrders")
  dispatchOffers Order[]   @relation("orderDispatchOffer")
  foodDispatchAttempts FoodDispatchAttempt[]
  offers      Offer[]
  settlements Settlement[]

  commissionAccount CommissionAccount?
  commissionLedger  CommissionLedger[]
  topUps            TopUp[]
  merchantDebtLedger MerchantDebtLedger[]

  @@map("riders")
}

// The prepaid commission float, 1:1 with a Rider. `balance` is a cached running total — always
// reconstructable by summing the rider's CommissionLedger. Lazily upserted on first touch so
// "account missing" is never a reachable failure inside the completion transaction (design eng 1A).
// No status column: a wallet freeze is a Rider.heldReason = "commission_freeze" hold (design OV-4A),
// so there is a single freeze authority. Balance writes take a row lock inside every ledger-writing
// transaction; balance may go negative (a debit that crossed zero is owed, netted by the next top-up).
model CommissionAccount {
  riderId   String   @id @map("rider_id") @db.Uuid
  rider     Rider    @relation(fields: [riderId], references: [profileId], onDelete: Cascade)
  balance   Decimal  @default(0) @db.Decimal(10, 2)
  currency  String   @default("USD")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("commission_accounts")
}

// Append-only ledger — one immutable row per balance change, so the balance is auditable and always
// reconstructable. `amount` is signed (credit +, debit −); `balanceAfter` is the running total after
// this row. A `ride_commission` row stores the `ratePct` it was charged at (design OV-2A) and links to
// its `orderId`; the UNIQUE (riderId, orderId, type) makes the per-ride debit idempotent under retries
// and keeps it exactly-once per order. `idemKey` (unique when present) makes manual/bulk credits
// idempotent. `topUpId` (unique when present) makes a top-up credit exactly-once.
model CommissionLedger {
  id           String              @id @default(uuid()) @db.Uuid
  riderId      String              @map("rider_id") @db.Uuid
  rider        Rider               @relation(fields: [riderId], references: [profileId], onDelete: Cascade)
  type         CommissionEntryType
  amount       Decimal             @db.Decimal(10, 2)
  balanceAfter Decimal             @map("balance_after") @db.Decimal(10, 2)
  // The commission debit's source ride (null for credits/adjustments not tied to a ride).
  orderId      String?             @map("order_id") @db.Uuid
  order        Order?              @relation(fields: [orderId], references: [id], onDelete: SetNull)
  // The rate a ride_commission was charged at, and the fare it derived from — the show-the-math receipt.
  ratePct      Decimal?            @map("rate_pct") @db.Decimal(5, 2)
  fare         Decimal?            @db.Decimal(10, 2)
  // The top-up this credit settled (null for commission/grace/adjustment). Unique → exactly-once credit.
  topUpId      String?             @unique @map("top_up_id") @db.Uuid
  topUp        TopUp?              @relation(fields: [topUpId], references: [id], onDelete: SetNull)
  // Idempotency key for credit-side writes (manual/bulk seed). Unique when present.
  idemKey      String?             @unique @map("idem_key")
  note         String?
  // system | an admin profile id — who wrote the row (audit trail).
  actor        String?
  createdAt    DateTime            @default(now()) @map("created_at")

  // WD-015: the real UNIQUENESS constraint — exactly one ride_commission row per order, ever — is now a
  // PARTIAL unique index (`type = 'ride_commission'` only), added by raw SQL migration since Prisma's
  // schema DSL can't express a partial index; see migrations 0030_commission_ledger_drop_blanket_unique /
  // 0031_commission_ledger_ride_commission_unique. Was a blanket @@unique([riderId, orderId, type]) until
  // then — that also (unintentionally) forced every `adjustment` row's orderId to stay NULL to avoid
  // colliding on a second correction, which broke settlements.service's per-order ledger reconciliation
  // (a NULL never matches an `orderId: { in: [...] } }` filter). `adjustment` rows now carry their real
  // orderId and can safely repeat it across multiple corrections on the same order.
  @@index([riderId, orderId, type])
  @@index([riderId, createdAt])
  @@map("commission_ledger")
}

// A top-up intent. Confirmation is exactly-once by construction: the credit transaction CAS-transitions
// status (pending|expired → confirmed) and CommissionLedger.topUpId is unique, so a replayed
// confirmation can neither re-transition nor double-credit. `providerRef` is the rail's transaction id
// or an admin idempotency key (unique).
model TopUp {
  id          String       @id @default(uuid()) @db.Uuid
  riderId     String       @map("rider_id") @db.Uuid
  rider       Rider        @relation(fields: [riderId], references: [profileId], onDelete: Cascade)
  rail        TopUpRail
  amount      Decimal      @db.Decimal(10, 2)
  phone       String?
  providerRef String?      @unique @map("provider_ref")
  status      TopUpStatus  @default(pending)
  initiatedAt DateTime     @default(now()) @map("initiated_at")
  expiresAt   DateTime     @map("expires_at")
  resolvedAt  DateTime?    @map("resolved_at")
  // BH-09: client-generated create-request dedup key (one per top-up attempt), mirroring
  // Order.idempotencyKey. A timeout+retry on `POST /wallet/topups` hits the same row (P2002 on the
  // partial unique index below) instead of opening a second pending intent for the same attempt.
  // Nullable — an old client that doesn't send one just never dedupes.
  idempotencyKey String? @map("idempotency_key")

  ledgerEntry CommissionLedger?

  @@index([riderId, initiatedAt])
  @@index([status])
  @@map("top_ups")
}

// (Partial unique index on (rider_id, idempotency_key) WHERE idempotency_key IS NOT NULL — added by
// raw SQL migration since Prisma's schema DSL can't express a partial index; built CONCURRENTLY, see
// migrations 0028_topup_idempotency_column / 0029_topup_idempotency_index.)

// DORMANT — the weekly cash-settlement model this table backed has been replaced by prepaid per-ride
// commission (see @lynia/shared COMMISSION + docs/plans/2026-biker-prepaid-commission.md). No code
// reads or writes it any more; it's left in place only to avoid a destructive migration and will be
// dropped (or repurposed for the prepaid ledger) when the wallet is built. Do not build against it.
model Settlement {
  id            String           @id @default(uuid()) @db.Uuid
  riderId       String           @map("rider_id") @db.Uuid
  rider         Rider            @relation(fields: [riderId], references: [profileId], onDelete: Cascade)
  periodStart   DateTime         @map("period_start")
  periodEnd     DateTime         @map("period_end")
  grossFares    Decimal          @default(0) @map("gross_fares") @db.Decimal(10, 2)
  commission    Decimal          @default(0) @db.Decimal(10, 2)
  refundsNetted Decimal          @default(0) @map("refunds_netted") @db.Decimal(10, 2)
  amountDue     Decimal          @default(0) @map("amount_due") @db.Decimal(10, 2)
  status        SettlementStatus @default(pending)
  dueDate       DateTime         @map("due_date")
  paidAt        DateTime?        @map("paid_at")
  method        String?
  createdAt     DateTime         @default(now()) @map("created_at")

  // One settlement per rider per period — idempotent regeneration of a window updates in place.
  @@unique([riderId, periodStart])
  @@index([status])
  @@index([riderId])
  @@map("settlements")
}

model Order {
  id              String      @id @default(uuid()) @db.Uuid
  orderType       OrderType   @default(parcel) @map("order_type")
  customerId      String      @map("customer_id") @db.Uuid
  customer        Profile     @relation("customerOrders", fields: [customerId], references: [id])
  riderId         String?     @map("rider_id") @db.Uuid
  rider           Rider?      @relation("riderOrders", fields: [riderId], references: [profileId])
  merchantId      String?     @map("merchant_id") @db.Uuid
  merchant        Merchant?   @relation(fields: [merchantId], references: [id])
  pickup          Json
  // Generated (STORED) geography point derived from pickup.point (managed via raw SQL migration
  // 0006). Indexed with GiST for the nearby-order board (ST_DWithin). Read-through only — Prisma
  // never writes an Unsupported column, so the generated-column contract is safe.
  pickupGeog      Unsupported("geography(Point, 4326)")? @map("pickup_geog")
  dropoff         Json
  itemDesc        String      @map("item_desc")
  // Line-items [{description, quantity}] — the §5b seam made real (item-model decision, packages/design/HANDOFF.md). Nullable:
  // rows created before migration 0008 (old clients via old API) stay null; itemDesc is always the
  // derived compact summary, so every itemDesc consumer keeps working unchanged.
  items           Json?
  note            String?
  itemPhotoUrl    String?     @map("item_photo_url")
  declaredValue   Decimal     @default(0) @map("declared_value") @db.Decimal(10, 2)
  size            String?
  distanceKm      Float?      @map("distance_km")
  suggestedFare   Decimal     @map("suggested_fare") @db.Decimal(10, 2)
  proposedFare    Decimal     @map("proposed_fare") @db.Decimal(10, 2)
  agreedFare      Decimal?    @map("agreed_fare") @db.Decimal(10, 2)
  currency        String      @default("USD")
  // Hashed delivery OTP — never store plaintext (ET7).
  otpHash             String?     @map("otp_hash")
  deliveryOtpAttempts Int         @default(0) @map("delivery_otp_attempts")
  // KB-DELIVERY-CODE-ROTATION-SIGNAL: when the delivery code was last (re)issued — stamped at
  // assignment (matching.selectOffer) and on every rotateDeliveryCode. Lets the rider app robustly
  // detect a code rotation (customer re-issued after a lockout) across an app-kill, more robustly than
  // the DS14-09 attempts-counter high-water mark. Nullable: null on pre-0026 rows / orders never
  // assigned a code. Additive, no default, no backfill.
  deliveryCodeRotatedAt DateTime? @map("delivery_code_rotated_at")
  status              OrderStatus @default(requested)
  confirmedAt         DateTime?   @map("confirmed_at")
  pickupStartedAt     DateTime?   @map("pickup_started_at")
  collectedAt         DateTime?   @map("collected_at")
  // Per-item pickup confirmation (rider "pickup item verification"): which indexes of `items` the
  // rider physically collected. Nullable — legacy orders + orders never through the checklist.
  itemsCollected      Json?       @map("items_collected")
  // Proof-of-pickup photo (§5c "parcel is with your rider — photo attached"): the object KEY of the
  // rider's optional parcel photo, taken at collection. Key, not URL — read URLs are minted on
  // demand in getSnapshot, mirroring riders.photo_url. Nullable: the photo is optional and must
  // never gate the collect, so most rows (and every pre-migration-0022 row) stay null.
  pickupPhotoKey      String?     @map("pickup_photo_key")
  deliveredAt         DateTime?   @map("delivered_at")
  completedAt         DateTime?   @map("completed_at")
  cancelledAt         DateTime?   @map("cancelled_at")
  cancelledBy         String?     @map("cancelled_by") @db.Uuid
  // FK → profiles(id). Nullable pointer to whoever cancelled; ON DELETE SET NULL so deleting a
  // profile doesn't block on this reference. See migration 0015.
  cancelledByProfile  Profile?    @relation("cancelledByOrders", fields: [cancelledBy], references: [id], onDelete: SetNull)
  cancelReason        String?     @map("cancel_reason")
  // Failed hand-off terminal (INTERFACE-AUDIT C6). Reason enum kept as text (shared UndeliveredReason);
  // deliveryAttempts is the recipient-contact attempt count shown to the customer.
  undeliveredReason   String?     @map("undelivered_reason")
  undeliveredAt       DateTime?   @map("undelivered_at")
  deliveryAttempts    Int         @default(0) @map("delivery_attempts")
  // KB-POD-DISPUTE Phase A — proof-of-drop evidence a rider can attach when a hand-off goes sideways
  // (recipient took the goods but withheld the delivery code). Optional, never gates any status; the
  // admin order-detail surfaces it (photo read-URL + GPS + time) so ops can adjudicate a Phase-B
  // "delivered — code bypass" decision. Photo is a GCS object key under `delivery-proof/<riderId>/`
  // (a read URL is minted on demand, like pickupPhotoKey); GPS proves the rider was at the drop.
  deliveryProofKey    String?     @map("delivery_proof_key")
  deliveryProofLat    Float?      @map("delivery_proof_lat")
  deliveryProofLng    Float?      @map("delivery_proof_lng")
  deliveryProofAt     DateTime?   @map("delivery_proof_at")
  // Pre-broadcast liability disclaimer consent (A1-8): {policy version, timestamp} on the order.
  disclaimerVersion    String?    @map("disclaimer_version")
  disclaimerAcceptedAt DateTime?  @map("disclaimer_accepted_at")
  // Rider-cancel auto re-broadcast (F-01): a new order cloned at the same price back-links here to
  // the order it replaced. Plain column (no relation) — a lineage pointer, not a hot-path join.
  rebroadcastOfId     String?     @map("rebroadcast_of_id") @db.Uuid
  // No-supply expiry (UX-2026-07-12 #11): true when the offer window closed with ZERO bids AND zero
  // riders online near the pickup, stamped best-effort post-commit in expireOrder. Drives the honest
  // "nobody was online" copy (feed + snapshot) over the default "raise your price" nudge. Nullable:
  // pre-migration rows and normal expiries stay null (= default copy).
  expiryNoSupply      Boolean?    @map("expiry_no_supply")
  // Client-generated create-request dedup key (one per compose attempt). A unique index scoped to the
  // customer lets a timeout+retry or a double-tap on "Broadcast" hit the same row (P2002) instead of
  // opening a second live auction for the same trip. Nullable — old clients that don't send one just
  // never dedupe (partial index, so NULLs don't collide).
  idempotencyKey      String?     @map("idempotency_key")
  createdAt           DateTime    @default(now()) @map("created_at")
  updatedAt           DateTime    @updatedAt @map("updated_at")

  // ── C2: food order lifecycle (orderType=merchant only; null for every parcel order) ──────────────
  // Kitchen-side sub-state OrderStatus has no room for (plan §0b.1) — null while status is anything
  // other than the merchant's pre-dispatch `requested` phase.
  merchantPhase MerchantPhase? @map("merchant_phase")
  // N-03: 3:00 accept window from order placement — the reconciler auto-cancels an order still
  // `awaiting_accept` past this stamp.
  acceptDeadlineAt DateTime? @map("accept_deadline_at")
  // D-23/N-18: 60s the customer has to approve a shortened (item-level accept) order.
  itemApprovalDeadlineAt DateTime? @map("item_approval_deadline_at")
  // D-11: the reason a merchant declined or released the order — this string IS the customer copy
  // (MERCHANT_REJECTION_REASONS in packages/shared), never a raw enum leaked to the client.
  rejectionReason String? @map("rejection_reason")
  // R-01/R-11: the customer's chosen settlement rail. Null for parcel orders.
  merchantPaymentMethod MerchantPaymentMethod? @map("merchant_payment_method")
  // R-16: "call before requesting payment" — the request-payment action is blocked until this is set
  // (or the regulars/in-person override is used).
  paymentCallLoggedAt DateTime? @map("payment_call_logged_at")
  paymentRequestedAt  DateTime? @map("payment_requested_at")
  // N-22: set the first (and only) time the reminder sweep pushes for this order — the idempotency
  // guard so a merchant's still-unpaid order gets nudged once, never a repeating nag.
  paymentReminderSentAt DateTime? @map("payment_reminder_sent_at")
  // D-24 manual rail: the reference the customer (or merchant, matching their own statement) entered.
  merchantPaymentReference String? @map("merchant_payment_reference")
  // R-11: the merchant's own-statement match — this is what starts the prep clock, not acceptance.
  merchantPaymentConfirmedAt DateTime? @map("merchant_payment_confirmed_at")
  // N-04 chip minutes (10/15/20/30/45), + N-17's +10 busy-mode bump already folded in at accept time.
  prepMinutes    Int?      @map("prep_minutes")
  prepStartedAt  DateTime? @map("prep_started_at")
  readyAt        DateTime? @map("ready_at")
  // N-16: 4-digit pickup code, hashed like otpHash — proves the rider at the counter is the one
  // assigned. Minted by C3's dispatch at assignment; verified here (mirrors confirmDelivery's shape).
  pickupCodeHash     String? @map("pickup_code_hash")
  pickupCodeAttempts Int     @default(0) @map("pickup_code_attempts")
  // D-08: money and delivery money are never merged into one figure for the merchant — this is what's
  // OWED TO THE MERCHANT (dish subtotal + N-15 small-order fee); deliveryFee is what the rider keeps.
  // agreedFare (existing column, reused) carries the grand total the customer pays (goods + delivery).
  merchantGoodsTotal Decimal? @map("merchant_goods_total") @db.Decimal(10, 2)
  // N-01: computed via packages/shared/restaurants-pricing (config, not a constant), never re-derived
  // client-side.
  deliveryFee Decimal? @map("delivery_fee") @db.Decimal(10, 2)

  // ── C3: food dispatch (orderType=merchant only) ─────────────────────────────────────────────────
  // Candidate rider currently holding a live single-rider auto-offer (N-08, 60s); null once
  // accepted/declined/expired. Distinct from `riderId` — this rider hasn't been assigned yet, just
  // asked, so it never touches the one_active_ride index.
  dispatchOfferedRiderId String?   @map("dispatch_offered_rider_id") @db.Uuid
  dispatchOfferedRider   Rider?    @relation("orderDispatchOffer", fields: [dispatchOfferedRiderId], references: [profileId])
  dispatchOfferExpiresAt DateTime? @map("dispatch_offer_expires_at")
  // Ticks used this dispatch lifetime (search-or-offer rounds), capped at
  // RESTAURANTS_DISPATCH.maxAttempts (N-07 ~6:00 NO_RIDER cap) — reset to 0 on an explicit merchant
  // "keep searching" (D-34) or a D-33 rider drop (a fresh re-dispatch budget).
  dispatchAttempt   Int       @default(0) @map("dispatch_attempt")
  dispatchStartedAt DateTime? @map("dispatch_started_at")
  // When the reconciler should next act on this order — a live offer's expiry, or "poll again" after
  // a tick found no candidate at all. Unifies both cases into the one sweep WHERE clause
  // (food-dispatch.service.ts); null only pre-first-attempt (dispatchAttempt=0 covers that case).
  dispatchNextCheckAt DateTime? @map("dispatch_next_check_at")
  // Riders already offered (declined/expired) this dispatch lifetime — never re-offered the same
  // rider twice in one cycle. Plain text[] (not uuid[] — Prisma's array modifier doesn't compose with
  // @db.Uuid), values are still valid rider profile-id strings.
  dispatchExcludedRiderIds String[] @default([]) @map("dispatch_excluded_rider_ids")
  // D-34: set when the NO_RIDER cap is exhausted — the merchant's "no rider found" hold, needing an
  // explicit keep-searching / cancel decision. Cleared on resume; the food itself is not re-cooked
  // (prep already completed before dispatch ever starts — see food-dispatch.service.ts docstring).
  noRiderHoldAt DateTime? @map("no_rider_hold_at")

  dispatchAttempts FoodDispatchAttempt[]

  // ── C4: food money evidence layer (orderType=merchant only) ────────────────────────────────────
  // R-03 snapshot: the merchant's cash rule AT PLACEMENT, so a mid-order shop-setting change never
  // retroactively changes an in-flight order's obligations. Null for WALLET orders (the rule never
  // applies) and for every parcel order.
  merchantCashRule MerchantCashRule? @map("merchant_cash_rule")
  // R-04 doorstep dual-confirm handshake (CASH food orders only, both cashRules — money changes
  // hands at the door either way, independent of who fronted the goods). "Food first" ordering:
  // customer confirms, THEN the rider confirms; only then does the delivery code unlock (R-09).
  cashHandshakeAmount     Decimal?  @map("cash_handshake_amount") @db.Decimal(10, 2)
  customerCashConfirmedAt DateTime? @map("customer_cash_confirmed_at")
  riderCashConfirmedAt    DateTime? @map("rider_cash_confirmed_at")
  // N-19: 2:00 from the customer's confirm. R-05: unresolved past this (or an explicit rider
  // dispute) freezes the trip — cashHandshakeFrozenAt stamps that, the rider takes no new jobs
  // until support (X1) resolves it.
  cashHandshakeDeadlineAt DateTime? @map("cash_handshake_deadline_at")
  cashHandshakeFrozenAt   DateTime? @map("cash_handshake_frozen_at")
  // R-01/R-06/N-20/N-21: the collect-and-return merchant-debt ledger's derived state — opened at
  // pickup (goods leave the counter unpaid), settled by the merchant's returned-cash count-confirm,
  // a goods-only return (refusal/no-show, no cash ever collected), or written off on non-return
  // (R-07, pairs with the rider's accountStatus=suspended). debtAmount is the merchantGoodsTotal
  // snapshot at the moment the debt opened (R-06: the GOODS value only, delivery fee excluded — the
  // rider keeps that).
  debtStatus    MerchantDebtStatus? @map("debt_status")
  debtAmount    Decimal?            @map("debt_amount") @db.Decimal(10, 2)
  debtOpenedAt  DateTime?           @map("debt_opened_at")
  debtSettledAt DateTime?           @map("debt_settled_at")
  // N-10 customer no-show at the door: call log (mirrors paymentCallLoggedAt's shape) a rider builds
  // up before `reportNoShow` is allowed (>= RESTAURANTS_DEBT.noShowMinCalls entries, the earliest at
  // least RESTAURANTS_DEBT.noShowWindowMs ago).
  noShowCallTimestamps DateTime[] @default([]) @map("no_show_call_timestamps")
  // D-12: a merchant can't reject/cancel an already-WALLET-paid order without entering their own
  // refund reference first — the customer's order keeps it forever as their evidence (never a
  // screenshot). N-12's 2h SLA escalation sweep is an open item, see the PR notes / plan §9 Q6.
  refundReference String?   @map("refund_reference")
  refundAmount    Decimal?  @map("refund_amount") @db.Decimal(10, 2)
  refundedAt      DateTime? @map("refunded_at")

  merchantDebtLedger MerchantDebtLedger[]

  offers Offer[]
  events OrderEvent[]
  merchantItems MerchantOrderItem[]
  // Two-way rating (BUG-HUNT P3): an order can now carry one rating per rater (customer + rider),
  // so this is a list — the single-row unique on ratings.order_id was widened to (order_id,
  // by_profile_id) in migration 0015. The rider's "rate the sender" (4·7) is the rider-direction row.
  rating Rating[]
  // Commission debits reference the ride they came from (at most one ride_commission row per order).
  commissionLedger CommissionLedger[]

  @@index([status])
  @@index([rebroadcastOfId])
  // Composite (role, created_at) indexes so the trip-history query — an OR over customer_id/rider_id
  // ordered by created_at — resolves as two index scans instead of a seq-scan-then-sort as `orders`
  // grows (E5). The (rider_id, created_at) index also covers the plain rider_id lookups the old
  // single-column index served (leftmost-prefix), so it replaces it.
  @@index([customerId, createdAt])
  @@index([riderId, createdAt])
  @@map("orders")
}

// (Partial unique index on (customer_id, idempotency_key) WHERE idempotency_key IS NOT NULL — added
// by raw SQL migration since Prisma's schema DSL can't express a partial index; built CONCURRENTLY,
// see migration 0021_order_idempotency_index.)

model Offer {
  id          String      @id @default(uuid()) @db.Uuid
  orderId     String      @map("order_id") @db.Uuid
  order       Order       @relation(fields: [orderId], references: [id], onDelete: Cascade)
  riderId     String      @map("rider_id") @db.Uuid
  rider       Rider       @relation(fields: [riderId], references: [profileId])
  type        OfferType
  offeredFare Decimal     @map("offered_fare") @db.Decimal(10, 2)
  etaMinutes  Int         @map("eta_minutes")
  status      OfferStatus @default(pending)
  createdAt   DateTime    @default(now()) @map("created_at")

  // One offer per rider per order — the "one round" rule as a constraint (ET7).
  @@unique([orderId, riderId])
  @@index([orderId, status])
  @@index([riderId])
  @@map("offers")
}

model OrderEvent {
  id        String      @id @default(uuid()) @db.Uuid
  orderId   String      @map("order_id") @db.Uuid
  order     Order       @relation(fields: [orderId], references: [id], onDelete: Cascade)
  status    OrderStatus
  lat       Float?
  lng       Float?
  createdAt DateTime    @default(now()) @map("created_at")

  // Composite (order_id, created_at) so the snapshot timeline read (filter order_id, order by
  // created_at asc) is an index-order scan; covers the plain order_id lookups too (E5).
  @@index([orderId, createdAt])
  @@map("order_events")
}

model Rating {
  id          String   @id @default(uuid()) @db.Uuid
  orderId     String   @map("order_id") @db.Uuid
  order       Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  byProfileId String   @map("by_profile_id") @db.Uuid
  by          Profile  @relation("ratingBy", fields: [byProfileId], references: [id])
  score       Int
  comment     String?
  createdAt   DateTime @default(now()) @map("created_at")

  // One rating per order per rater (BUG-HUNT P3) — replaces the single-column order_id unique
  // that capped an order at one rating and so blocked two-way (customer<->rider) rating.
  @@unique([orderId, byProfileId])
  @@map("ratings")
}

// A dispute / help request raised against an order (A-05). Party IDs are plain UUIDs (no relation) so
// the row survives a profile delete for the audit trail; the order + OTP/events are the evidence.
model Issue {
  id                String           @id @default(uuid()) @db.Uuid
  orderId           String           @map("order_id") @db.Uuid
  openedByProfileId String           @map("opened_by_profile_id") @db.Uuid
  openedByRole      Role             @map("opened_by_role")
  type              IssueType
  status            IssueStatus      @default(open)
  description       String
  resolution        IssueResolution?
  resolutionNote    String?          @map("resolution_note")
  resolvedByAdminId String?          @map("resolved_by_admin_id") @db.Uuid
  resolvedAt        DateTime?        @map("resolved_at")
  createdAt         DateTime         @default(now()) @map("created_at")
  // BH-22: client-generated create-request dedup key (mirrors TopUp.idempotencyKey). A lost-response
  // retry on `POST /orders/:id/issues` hits the same row (P2002 on the partial unique index below)
  // instead of opening a second dispute for the same complaint. Nullable — an old client that doesn't
  // send one just never dedupes.
  idempotencyKey String? @map("idempotency_key")

  @@index([status, createdAt])
  @@index([orderId])
  @@map("issues")
}

// (Partial unique index on (opened_by_profile_id, idempotency_key) WHERE idempotency_key IS NOT NULL —
// added by raw SQL migration since Prisma's schema DSL can't express a partial index; built
// CONCURRENTLY, see migrations 0035_issue_idempotency_column / 0036_issue_idempotency_index.)

// Report-a-user after a trip (both roles). subjectProfileId is indexed so ops can count reports per
// party (feeds fault attribution alongside the reliability score).
model Report {
  id                String       @id @default(uuid()) @db.Uuid
  orderId           String?      @map("order_id") @db.Uuid
  reporterProfileId String       @map("reporter_profile_id") @db.Uuid
  reporterRole      Role         @map("reporter_role")
  subjectProfileId  String       @map("subject_profile_id") @db.Uuid
  subjectRole       Role         @map("subject_role")
  reason            ReportReason
  note              String?
  createdAt         DateTime     @default(now()) @map("created_at")

  // One report per (order, reporter, subject) — a party can't inflate the other's fault count by
  // reporting the same trip repeatedly. Re-reporting updates the reason/note in place (upsert).
  @@unique([orderId, reporterProfileId, subjectProfileId])
  @@index([subjectProfileId])
  @@map("reports")
}

// A block prevents a future rematch between the two parties (server-enforced in matching/broadcast).
model Block {
  id               String   @id @default(uuid()) @db.Uuid
  blockerProfileId String   @map("blocker_profile_id") @db.Uuid
  blockedProfileId String   @map("blocked_profile_id") @db.Uuid
  createdAt        DateTime @default(now()) @map("created_at")

  @@unique([blockerProfileId, blockedProfileId])
  @@index([blockerProfileId])
  @@map("blocks")
}

// An SOS raised on a live trip by either party (safety, R-16/F-13). Logged + pushed to ops; the app
// surfaces the emergency contacts (policy.ts SOS_POLICY). acknowledgedAt when ops responds.
model SosEvent {
  id                String    @id @default(uuid()) @db.Uuid
  orderId           String    @map("order_id") @db.Uuid
  raisedByProfileId String    @map("raised_by_profile_id") @db.Uuid
  raisedByRole      Role      @map("raised_by_role")
  lat               Float?
  lng               Float?
  acknowledgedAt    DateTime? @map("acknowledged_at")
  createdAt         DateTime  @default(now()) @map("created_at")

  @@index([orderId])
  @@index([createdAt])
  @@map("sos_events")
}

// A refund owed to a customer, netted off the rider's weekly commission (A-06 settlement netting).
// settlementId links the refund to the settlement window that absorbed it (null until netted).
model Refund {
  id           String   @id @default(uuid()) @db.Uuid
  orderId      String   @map("order_id") @db.Uuid
  riderId      String   @map("rider_id") @db.Uuid
  amount       Decimal  @db.Decimal(10, 2)
  reason       String?
  settlementId String?  @map("settlement_id") @db.Uuid
  createdAt    DateTime @default(now()) @map("created_at")

  @@index([riderId, createdAt])
  @@index([settlementId])
  @@map("refunds")
}

// Server-side sessions so we own revoke/ban/logout (ET5).
model Session {
  id               String    @id @default(uuid()) @db.Uuid
  profileId        String    @map("profile_id") @db.Uuid
  profile          Profile   @relation(fields: [profileId], references: [id], onDelete: Cascade)
  refreshTokenHash String    @map("refresh_token_hash")
  userAgent        String?   @map("user_agent")
  // KB-IDENTITY-BINDING L1: the client's stable per-install device id (from the `x-device-id` header),
  // recorded so signup can be throttled per device and the L0 recycle-detection signal can see the
  // device↔account history. Null for older clients that send no id. A soft signal, not a guarantee.
  deviceId         String?   @map("device_id")
  expiresAt        DateTime  @map("expires_at")
  revokedAt        DateTime? @map("revoked_at")
  // Rotation successor link (RT-GRACE): when this session is revoked BY BEING ROTATED in refresh(),
  // this points at the freshly-minted successor session. Null means "not rotated" — either still live,
  // or revoked for another reason (logout / future security revoke). It is the discriminator the
  // lost-response grace path keys off: only a rotation-revoke (rotatedToId set) whose successor is still
  // un-consumed qualifies for a re-issue; a logout-revoke (null) never does.
  rotatedToId      String?   @map("rotated_to_id") @db.Uuid
  createdAt        DateTime  @default(now()) @map("created_at")

  @@index([profileId])
  @@map("sessions")
}

// Admin audit trail (INTERFACE-AUDIT A-01, compliance). Every destructive console action
// (suspend / lift / ban / decline / refund / cancel / flag / clear / settle) writes one row here so
// the intent is recorded server-side and queryable — closing the "UI-only seam" where the console
// posted an action nowhere. `actor` is the authenticated admin's profile id; `action` + `target`
// identify what was done to whom; `reasonCode` + `note` carry the ConfirmModal justification. Plain
// columns (no FK on actor/target) so an audit row survives even if the referenced row is later
// deleted — an audit log must be append-only and outlive its subjects.
model AuditLog {
  id         String   @id @default(uuid()) @db.Uuid
  actor      String
  action     String
  target     String
  reasonCode String?  @map("reason_code")
  note       String?
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([createdAt])
  @@map("audit_logs")
}

// Restaurants vertical (C1, docs/plans/2026-07-28-restaurants-send-joint-launch-plan.md §5 Lane C).
// The owning login is a Profile with role="merchant" (mirrors Rider: `becomeMerchant` upgrades an
// existing customer profile in-place, same shape as RiderService.becomeRider) — phone/OTP auth is
// entirely reused, never duplicated. Masked-phone display (D-17) reads `ownerProfile.phone` through
// the existing `maskPhone()` helper; no phone is duplicated onto this row.
model Merchant {
  id             String           @id @default(uuid()) @db.Uuid
  name           String
  ownerProfileId String?          @unique @map("owner_profile_id") @db.Uuid
  ownerProfile   Profile?         @relation(fields: [ownerProfileId], references: [id])
  description    String?
  // D-30 shop front: 3:1 cover banner + round logo, up to 3 cuisine tags, price level 1-3.
  coverPhotoUrl  String?          @map("cover_photo_url")
  logoUrl        String?          @map("logo_url")
  cuisineTags    String[]         @map("cuisine_tags")
  priceLevel     Int?             @map("price_level")
  // Weekly open/close windows, e.g. {"mon": {"open": "08:00", "close": "22:00"}, ...}. Nullable —
  // an onboarding merchant has no hours yet; absence is read as "hours not set" by the client, not
  // "always open".
  hours          Json?
  // R-03: the merchant's own cash-handling rule, shown to riders on the offer before they accept.
  cashRule       MerchantCashRule @default(collect_and_return) @map("cash_rule")
  // N-17 busy mode: a manual on/off the merchant flips from the kitchen board (E2/E4); a plain
  // +10min prep-time bump signal while true, no auto-expiry specified.
  busyMode       Boolean          @default(false) @map("busy_mode")
  // Pre-launch pilot-corridor allowlist (status-keyed-query-audit.md "P0 exit-gate status" — the
  // seeded-cohort leg this field unblocks). A merchant is only visible on the customer-facing
  // restaurant list/menu when this is true, even with RESTAURANTS_ENABLED=true globally — the
  // per-merchant gate for the founder's named CBD pilot corridor. Defaults false: dormant until an
  // operator explicitly onboards the shop.
  pilotEnabled   Boolean          @default(false) @map("pilot_enabled")
  // C2: the shop's own pickup point (same Waypoint shape as Order.pickup — {point:{lat,lng},
  // landmark, contactPhone}), set by the merchant before it can take orders. Nullable: onboarding
  // merchants have no location yet, so placeOrder 409s until it's set. Plain JSON for now — C3's
  // dispatch adds its own generated-geography column (mirrors orders.pickup_geog) when it needs a
  // GiST radius search; this field is read-through only until then.
  location       Json?
  createdAt      DateTime         @default(now()) @map("created_at")
  updatedAt      DateTime         @updatedAt @map("updated_at")

  orders     Order[]
  categories MerchantCategory[]
  debtLedger MerchantDebtLedger[]

  @@map("merchants")
}

enum MerchantCashRule {
  collect_and_return
  pay_upfront
}

// D-29: the merchant owns the menu structure — categories are created first, dishes are added into
// one. Deletable only once empty (enforced in MerchantService, not the DB) so a dish is never
// orphaned by a category delete.
model MerchantCategory {
  id            String   @id @default(uuid()) @db.Uuid
  merchantId    String   @map("merchant_id") @db.Uuid
  merchant      Merchant @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  name          String
  sortOrder     Int      @default(0) @map("sort_order")
  // Time-limited availability window, e.g. Breakfast 07:00-11:00 (D-29). Both null = always available.
  availableFrom String?  @map("available_from")
  availableTo   String?  @map("available_to")
  hidden        Boolean  @default(false)
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  dishes MerchantDish[]

  @@index([merchantId])
  @@map("merchant_categories")
}

// D-31: a dish with no photo saves as a draft (isDraft true) — visible to the kitchen, invisible to
// the customer-facing menu. N-14: out-of-stock defaults to "for the rest of today", tracked by
// outOfStockUntil rather than a plain boolean so the daily auto-reset needs no reset job — the
// customer read API treats a past/null outOfStockUntil as back in stock.
model MerchantDish {
  id              String           @id @default(uuid()) @db.Uuid
  categoryId      String           @map("category_id") @db.Uuid
  category        MerchantCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  // Denormalized for merchant-scoped dish queries/counts without a join through category.
  merchantId      String           @map("merchant_id") @db.Uuid
  name            String
  description     String?
  priceUsd        Decimal          @db.Decimal(10, 2) @map("price_usd")
  photoUrl        String?          @map("photo_url")
  isDraft         Boolean          @default(true) @map("is_draft")
  outOfStockUntil DateTime?        @map("out_of_stock_until")
  sortOrder       Int              @default(0) @map("sort_order")
  createdAt       DateTime         @default(now()) @map("created_at")
  updatedAt       DateTime         @updatedAt @map("updated_at")

  orderItems MerchantOrderItem[]

  @@index([categoryId])
  @@index([merchantId])
  @@map("merchant_dishes")
}

// C2: a food order's basket lines, price-snapshotted at placement (D-35 "a note can never alter the
// price"). `dishId` is SetNull on dish delete so a historical order line survives a menu edit; the
// snapshot fields are what render on the receipt/ticket regardless. `available` is D-23's item-level
// accept: null = merchant hasn't decided, true = kept, false = "don't have it" (the removed line the
// customer approves within N-18's 60s window).
model MerchantOrderItem {
  id           String        @id @default(uuid()) @db.Uuid
  orderId      String        @map("order_id") @db.Uuid
  order        Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)
  dishId       String?       @map("dish_id") @db.Uuid
  dish         MerchantDish? @relation(fields: [dishId], references: [id], onDelete: SetNull)
  nameSnapshot String        @map("name_snapshot")
  priceUsd     Decimal       @map("price_usd") @db.Decimal(10, 2)
  quantity     Int
  note         String?
  available    Boolean?
  createdAt    DateTime      @default(now()) @map("created_at")

  @@index([orderId])
  @@map("merchant_order_items")
}

// C3: one row per dispatch tick that produced a live offer to a candidate rider — the "DispatchDecision
// log" (plan §0b/P4 seam), and the audit trail behind dispatchExcludedRiderIds (never re-offer the same
// rider twice in one order's dispatch lifetime, enforced at the DB by the unique index below, not just
// application logic). A tick that finds no candidate at all writes no row (nothing to log).
model FoodDispatchAttempt {
  id            String              @id @default(uuid()) @db.Uuid
  orderId       String              @map("order_id") @db.Uuid
  order         Order               @relation(fields: [orderId], references: [id], onDelete: Cascade)
  riderId       String              @map("rider_id") @db.Uuid
  rider         Rider               @relation(fields: [riderId], references: [profileId], onDelete: Cascade)
  attemptNumber Int                 @map("attempt_number")
  radiusM       Int                 @map("radius_m")
  offeredAt     DateTime            @map("offered_at")
  expiresAt     DateTime            @map("expires_at")
  outcome       FoodDispatchOutcome @default(pending)
  respondedAt   DateTime?           @map("responded_at")
  createdAt     DateTime            @default(now()) @map("created_at")

  @@unique([orderId, riderId])
  @@index([orderId])
  @@map("food_dispatch_attempts")
}

enum FoodDispatchOutcome {
  pending
  accepted
  declined
  expired
}

// C4 (food money evidence layer): append-only ledger backing Order.debtStatus — one immutable row
// per money-relevant event on a collect-and-return CASH order's debt (opened at pickup, settled by
// cash/goods return, or written off on non-return). `amount` is always positive (the goods value);
// `type` carries the direction, mirroring CommissionLedger's "one row per event, never mutated"
// contract. `@@unique([orderId, type])` is the idempotency guard — a retried settle call can never
// double-write, and there is at most one `opened` + one settling row per order, ever.
model MerchantDebtLedger {
  id         String                @id @default(uuid()) @db.Uuid
  orderId    String                @map("order_id") @db.Uuid
  order      Order                 @relation(fields: [orderId], references: [id], onDelete: Cascade)
  merchantId String                @map("merchant_id") @db.Uuid
  merchant   Merchant              @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  riderId    String                @map("rider_id") @db.Uuid
  rider      Rider                 @relation(fields: [riderId], references: [profileId], onDelete: Cascade)
  type       MerchantDebtEntryType
  amount     Decimal               @db.Decimal(10, 2)
  note       String?
  // system | an admin/merchant profile id — who wrote the row (audit trail, mirrors CommissionLedger).
  actor      String?
  createdAt  DateTime              @default(now()) @map("created_at")

  @@unique([orderId, type])
  @@index([riderId, merchantId])
  @@index([merchantId, createdAt])
  @@map("merchant_debt_ledger")
}

model Address {
  id        String   @id @default(uuid()) @db.Uuid
  profileId String   @map("profile_id") @db.Uuid
  profile   Profile  @relation(fields: [profileId], references: [id], onDelete: Cascade)
  label     String
  point     Json
  createdAt DateTime @default(now()) @map("created_at")

  @@index([profileId])
  @@map("addresses")
}
