# The pilot project_id is already the default in variables.tf (lynia-500911), so
# you can run `terraform plan` with NO tfvars file at all. Copy this to
# terraform.tfvars only to override a default below.

# project_id = "lynia-500911"  # already the default; uncomment to point elsewhere

# region        = "africa-south1"
# db_tier       = "db-custom-1-3840"   # downsize to "db-g1-small" to stretch credits
# bucket_name   = "lynia-media"

# --- Only if you want Terraform to create the project (needs org perms + billing) ---
# create_project  = true
# org_id          = "123456789012"     # or set folder_id instead
# billing_account = "XXXXXX-XXXXXX-XXXXXX"

# --- Once Workload Identity Federation is wired, stop minting an SA key ---
# emit_deployer_sa_key = false

# =============================================================================
# Hardened production posture (docs/INFRA-HARDENING-ROLLOUT.md)
# -----------------------------------------------------------------------------
# Every flag below defaults to the CURRENT deployed behaviour so a plain apply is
# a no-op. Turning them on is the security hardening for launch — but several are
# COORDINATED rollouts (a bad-order apply can drop a live connection or fail the
# apply), so do NOT just paste this block and apply. Follow the ordered runbook in
# docs/INFRA-HARDENING-ROLLOUT.md, which sequences each change with its verify +
# rollback step. Uncomment items as you complete each runbook stage.

# -- Data-plane privacy / encryption --
# redis_tls_enabled  = true    # COORDINATED: in-transit TLS + rediss:// URL. Runbook §2.
# db_public_ip_enabled = false  # COORDINATED: private-only SQL; needs DB_PRIVATE_ONLY migration path. Runbook §1.
# kyc_cmek_enabled   = true    # customer-managed key on the media bucket. Runbook §3.
# kyc_retention_days = 365     # DECISION: auto-delete KYC/media past N days (dispute/compliance-aware). Runbook §4.

# -- Edge protection --
# armor_waf_preview  = false   # enforce the OWASP WAF (deny 403) instead of log-only. Runbook §5 (observe preview first).
# bucket_cors_origins = ["https://admin.lyniafinance.com"]  # only if the admin console does browser uploads; never ["*"].

# =============================================================================
# Admin console tier (admin.tf; docs/plans/2026-admin-console-deployment.md)
# -----------------------------------------------------------------------------
# All off by default — a plain apply is a no-op. Arming stands up the IAP-gated
# admin console at admin_domain on the shared ALB. Sequence: create the IAP OAuth
# client (Phase 5), set the vars below, apply, add the DNS A record (Phase 6).
# admin_enabled                  = true
# admin_domain                   = "lyniagoadmin.lyniafinance.com"  # already the default
# Custom OAuth client from an EXTERNAL, published consent screen (Google-managed client won't work in an
# org with no Cloud Identity directory; the IAP OAuth Admin API is shut down). See arming runbook §1.
# admin_iap_oauth_client_id      = "XXXX.apps.googleusercontent.com"
# admin_iap_oauth_client_secret  = "GOCSPX-..."   # keep in a VCS-ignored tfvars
# admin_iap_members              = ["user:you@gmail.com"]  # ONLY authz boundary — explicit list, never allUsers

# -- Availability (pre-launch, not pilot) --
# redis_tier = "STANDARD_HA"   # Redis replica for HA. Recreates the instance — Runbook §6.
# (Cloud SQL REGIONAL HA: set availability_type = "REGIONAL" in sql.tf — Runbook §6.)

# =============================================================================
# Cloudflare DNS (dns.tf)
# -----------------------------------------------------------------------------
# Off by default — a plain apply is a no-op and existing hand-managed DNS is left
# alone. Arming brings the product's A records under Terraform, all pointing at
# the shared ALB (load_balancer_ip): api_domain always, staging_api_domain /
# admin_domain only when their tiers are also enabled. Records are DNS-only
# (grey-cloud); do NOT proxy them — it breaks Google-managed TLS + mobile cert
# pinning (see the header of dns.tf).
# cloudflare_dns_enabled = true
# cloudflare_zone_id     = "0123456789abcdef0123456789abcdef"  # lyniafinance.com zone id
# cloudflare_api_token   = "..."   # Zone:DNS:Edit token — keep in a VCS-ignored tfvars

# =============================================================================
# Maps Platform client API keys (apikeys.tf)
# -----------------------------------------------------------------------------
# Off by default — a plain apply is a no-op and the hand-created keys are left
# alone. Arming brings both client keys under Terraform with the docs/SECURITY-OPS.md
# §B restrictions: the Maps SDK key restricted to the Android package + signing
# certs, the Places key deliberately UNrestricted by application (it calls
# web-service endpoints, which return REQUEST_DENIED to an Android-restricted key —
# the symptom is a search box that silently returns nothing).
#
# ⚠️  IMPORT BEFORE YOU APPLY, AND SET THE KEY IDS FIRST. Both keys already exist.
#     Terraform's `name` is the key's IMMUTABLE id (the final component of
#     projects/N/locations/global/keys/<KEY_ID>) and is ForceNew — so an id that
#     doesn't match the imported key plans a DESTROY + CREATE of a live key, taking
#     the map down and minting a key string nothing has. Get the real ids with:
#
#       gcloud services api-keys list --project <project> --format='table(name,displayName)'
#
#     ...and note that is `name`, NOT the `uid` field — uid is an output-only UUID4
#     the import path does not accept. Then import (commands in apikeys.tf) and read
#     the plan: it should show ONLY in-place restriction changes. If it proposes
#     creating, destroying or replacing a key, stop.
#
# Both SHA-1s belong in the list. Play RE-SIGNS the AAB with the app-signing
# certificate, so a key allowlisted only for the EAS upload keystore works in a
# sideloaded APK and fails in every Play-installed build (MOB-MAP-02).
#
# The fingerprints below are syntactically valid PLACEHOLDERS so the shape is
# unambiguous — they are not real and must both be replaced, or the map will be
# restricted to certificates that do not exist.
# maps_api_keys_enabled          = true
# The real ids look like UUIDs. They are NOT written here even as examples: a
# UUID-shaped value next to a *_key_id assignment trips gitleaks' generic-api-key
# rule, and the honest fix is a placeholder that cannot be mistaken for a
# credential rather than an entry in .gitleaks.toml's allowlist (that allowlist is
# deliberately scoped to test fixtures). Your filled-in tfvars is gitignored.
# maps_api_key_id                = "REPLACE-with-the-KEY_ID-printed-above"
# places_api_key_id              = "REPLACE-with-the-KEY_ID-printed-above"
# android_package_name           = "zw.co.lynia"   # already the default
# android_cert_sha1_fingerprints = [
#   "00:11:22:33:44:55:66:77:88:99:AA:BB:CC:DD:EE:FF:00:11:22:33",  # REPLACE — Play app signing (Play Console → Test and release → Setup → App integrity)
#   "44:55:66:77:88:99:AA:BB:CC:DD:EE:FF:00:11:22:33:44:55:66:77",  # REPLACE — EAS upload keystore, for sideloaded QA APKs
# ]
