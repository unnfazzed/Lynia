# Cloud Run multi-container service TEMPLATE — adds the OTel Collector sidecar to lynia-api.
#
# ⚠️ SUPERSEDED (2026-07-13): the sidecar is now folded into .github/workflows/release.yml behind the
# OTEL_SIDECAR_ENABLED repo Variable — activation is a flag flip + release re-run, and the revision
# spec is code-driven on every deploy (docs/OBSERVABILITY.md → Production activation). This template
# is retained ONLY as a manual fallback / reference for the container spec (probe, resources, mounts).
#
# Original rationale for the template + `gcloud run services replace` path, kept for history:
# the normal deploy was a single-container `gcloud run deploy`; folding the sidecar in blind risked
# breaking ALL deploys for a telemetry feature, so the founder applied this once, deliberately.
#
# FILL THE <PLACEHOLDERS> (they mirror the flags in release.yml's `gcloud run deploy`), then:
#   gcloud run services replace infra/otel-collector/service.yaml --region <REGION> --project <PROJECT_ID>
#
# NOTE: exactly one container is the ingress container (the API, containerPort 3000). The collector is
# a sidecar with NO ports block — the API reaches it over localhost:4318. Subsequent normal
# release-workflow deploys do NOT drop this sidecar: `gcloud run deploy --image` PRESERVES existing
# sidecars, so once you apply this, every release inherits it (and a broken collector then wedges all
# deploys — this happened 2026-07-08→07-10). release.yml therefore refuses to deploy while an
# unexpected sidecar is present unless the OTEL_SIDECAR_ENABLED=true repo Variable is set. To return to
# single-container: `gcloud run services update lynia-api --region <REGION> --remove-containers otel-collector`.

apiVersion: serving.knative.dev/v1
kind: Service
metadata:
  name: lynia-api
  labels:
    cloud.googleapis.com/location: <REGION> # e.g. africa-south1
  annotations:
    run.googleapis.com/ingress: internal-and-cloud-load-balancing
spec:
  template:
    metadata:
      annotations:
        run.googleapis.com/execution-environment: gen2
        run.googleapis.com/cloudsql-instances: <CLOUD_SQL_INSTANCE> # = --add-cloudsql-instances
        run.googleapis.com/vpc-access-connector: <VPC_CONNECTOR>
        run.googleapis.com/vpc-access-egress: private-ranges-only
        # Config for the sidecar, mounted from a Secret Manager secret (see runbook step 2).
    spec:
      serviceAccountName: <CLOUD_RUN_SERVICE_ACCOUNT> # lynia-run runtime SA
      timeoutSeconds: 3600
      containers:
        # --- Ingress container: the API (unchanged from release.yml, plus the OTLP endpoint) ---
        - name: api
          image: <REGION>-docker.pkg.dev/<PROJECT_ID>/<ARTIFACT_REPO>/lynia-api:<GIT_SHA>
          ports:
            - containerPort: 3000
          env:
            # Turns the dormant OTLP exporters on — points them at the sidecar. This env lives HERE
            # (coupled to the sidecar), NOT in release.yml, so "endpoint set" ⇔ "collector present".
            - name: OTEL_EXPORTER_OTLP_ENDPOINT
              value: http://localhost:4318
            - name: OTEL_SERVICE_NAME
              value: lynia-api
            # ... reproduce every other --set-env-vars / --set-secrets entry from release.yml here ...
        # --- Sidecar: the OTel Collector (no ports → not the ingress container) ---
        # Pull THROUGH the project's Docker Hub remote-repo mirror in Artifact Registry, not docker.io
        # directly: a direct pull hits Docker Hub's anonymous rate limit, and the first activation
        # attempt pushed nothing to the private `lynia` repo yet referenced it, so the revision 404'd on
        # a missing image. Once you've confirmed the tag resolves in the mirror, pin it by @sha256 digest.
        - name: otel-collector
          image: <REGION>-docker.pkg.dev/<PROJECT_ID>/dockerhub-remote/otel/opentelemetry-collector-contrib:0.116.0
          args: ["--config=/etc/otelcol/config.yaml"]
          resources:
            limits:
              cpu: "1"
              memory: 256Mi
          # Probe the collector's health_check extension (config.yaml, :13133). A crash-looping or
          # misconfigured collector then fails ITS OWN startup and is reported as the failing container,
          # instead of silently killing the whole instance and mis-blaming the api:3000 probe.
          startupProbe:
            httpGet:
              path: /
              port: 13133
            periodSeconds: 5
            failureThreshold: 12
          volumeMounts:
            - name: otel-config
              mountPath: /etc/otelcol
      volumes:
        # Deliver config.yaml as a Secret Manager secret (runbook step 2 creates it from
        # infra/otel-collector/config.yaml). Alternative: bake it into a thin custom collector image.
        - name: otel-config
          secret:
            secretName: otel-collector-config
            items:
              - key: latest
                path: config.yaml
