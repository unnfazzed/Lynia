# The SECRET part of the server's .env (docs/AZURE-EXIT.md).
#
# Paste these lines, filled in, as ONE GitHub repository secret named SELFHOST_ENV. The deploy workflow
# writes it to the server as .env (owner-only), then adds the plain settings it builds from the repo's
# existing Variables (OTP_CHANNEL, KYC_MODE, PAYNOW_ENABLED, ...), exactly as release-azure.yml did.
# Never commit a filled-in copy. Values with spaces or newlines: wrap in single quotes.

# --- Database (new, made up by you: any long random strings) ---
POSTGRES_USER=lynia
POSTGRES_PASSWORD=
POSTGRES_DB=lynia

# --- From Azure Key Vault (copy BEFORE the subscription goes; see docs/AZURE-EXIT.md) ---
# PII_ENCRYPTION_KEY decrypts the stored national IDs: losing it loses them.
PII_ENCRYPTION_KEY=
JWT_SIGNING_SECRET=
TOKEN_HASH_SECRET=
ADMIN_API_TOKEN=

# --- Vendor keys you already use (only the ones whose feature is on) ---
DIDIT_API_KEY=
DIDIT_WEBHOOK_SECRET=
BIRD_ACCESS_KEY=
BIRD_VERIFY_API_KEY=
BIRD_WEBHOOK_SECRET=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
PAYNOW_INTEGRATION_KEY=
LOCAL_SMS_API_KEY=
TELEGRAM_BOT_TOKEN=
SENTRY_DSN=
FCM_SERVICE_ACCOUNT_JSON=
APNS_PRIVATE_KEY=

# --- Cloudflare (new) ---
# R2: Cloudflare dashboard → R2 → Manage API tokens → Object Read & Write, buckets lynia-media + lynia-backups.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
STORAGE_BUCKET=lynia-media
BACKUP_BUCKET=lynia-backups
# Tunnel: Zero Trust → Networks → Tunnels → Create (cloudflared) → copy the token.
TUNNEL_TOKEN=
# Access: Zero Trust → Access → Applications → the admin app → Overview → Application Audience (AUD) Tag.
ADMIN_CONSOLE_CF_ACCESS_TEAM_DOMAIN=yourteam.cloudflareaccess.com
ADMIN_CONSOLE_CF_ACCESS_AUD=
ADMIN_CONSOLE_ALLOWED_OPERATORS=

# --- New secrets (make up: `openssl rand -hex 32`, or 64 random letters/digits) ---
SCHEDULER_SECRET=
# Encrypts the nightly database backups. Keep a copy outside GitHub, like DB_EXPORT_PASSPHRASE.
BACKUP_PASSPHRASE=
